<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code contains 'ar' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {{ content_for_header }}
    {% style %}
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      :root {
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-sans: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-display: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --navy-700: {{ settings.color_primary }};
        --accent: {{ settings.color_primary }};
        --brass-500: {{ settings.color_accent }};
        --paper: {{ settings.color_background }};
      }
    {% endstyle %}
    {{ 'amoy.css' | asset_url | stylesheet_tag }}
    {%- if request.locale.iso_code == 'ar' and settings.load_arabic_font -%}
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
      <style>:root{--font-display:'IBM Plex Sans Arabic',sans-serif}body,button,input{font-family:'IBM Plex Sans Arabic',sans-serif}</style>
    {%- endif -%}
  </head>
  <body class="template-password">
    {{ content_for_layout }}
  </body>
</html>
