<!-- AMOY Custom — Blog Card Snippet -->
{%- assign words = article.content | strip_html | number_of_words -%}
{%- assign read_time = words | divided_by: 200 | plus: 1 -%}
{%- assign is_certified = false -%}
{%- for tag in article.tags -%}
  {%- if tag contains 'Certified' -%}{%- assign is_certified = true -%}{%- endif -%}
{%- endfor -%}
<article class="post-card">
  <a href="{{ article.url }}" class="post-card-link" aria-label="{{ article.title | escape }}">
    <div class="card-img">
      {%- if article.image -%}
        <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="700" height="438" loading="lazy">
      {%- else -%}
        <div class="img-placeholder">{{ article.title | truncate: 1, '' }}</div>
      {%- endif -%}
    </div>
    <div class="card-body">
      {%- if article.tags.size > 0 -%}
        <span class="post-category {% if is_certified %}certified{% endif %}">{{ article.tags.first }}</span>
      {%- endif -%}
      <h3 class="card-title">{{ article.title }}</h3>
      <p class="card-excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
      <div class="post-meta">
        <span>{{ article.published_at | date: '%B %d, %Y' }}</span>
        <span class="post-meta-sep"></span>
        <span>{{ read_time }} min read</span>
      </div>
      <span class="read-more">Read article &rarr;</span>
    </div>
  </a>
</article>