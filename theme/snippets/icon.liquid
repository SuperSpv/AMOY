  {%- when 'instagram' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'tiktok' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16 3c.3 2 1.6 3.6 3.6 3.9v2.4c-1.3.1-2.6-.3-3.6-1v6.1a5.5 5.5 0 1 1-5.5-5.5c.3 0 .6 0 .9.1v2.5a3 3 0 1 0 2.1 2.9V3H16Z"/></svg>
  {%- when 'snapchat' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2c2.3 0 4.1 1.9 4.2 4.2 0 .6 0 1.3-.1 1.9.3.2.7.2 1 .1.6-.2 1.2.6.6 1.2-.4.4-1.2.5-1.4 1-.2.8 1.6 2.8 3.1 3.2.4.1.4.6.1.8-.6.5-1.6.4-2.1 1-.2.4.1 1-.5 1.1-.6.1-1.2-.3-1.9-.1-.6.2-1.1 1-2.1 1.2-1.1.2-1.9-.6-2.9-.6s-1.8.8-2.9.6c-1-.2-1.5-1-2.1-1.2-.7-.2-1.3.2-1.9.1-.6-.1-.3-.7-.5-1.1-.5-.6-1.5-.5-2.1-1-.3-.2-.3-.7.1-.8C6.2 14.8 8 12.8 7.8 12c-.2-.5-1-.6-1.4-1-.6-.6 0-1.4.6-1.2.3.1.7.1 1-.1-.1-.6-.1-1.3-.1-1.9C7.9 3.9 9.7 2 12 2Z"/></svg>
  {%- when 'x' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M18.9 2H22l-7.6 8.7L23 22h-6.8l-5.3-6.9L4.8 22H2l8.1-9.3L1.5 2h6.9l4.8 6.3L18.9 2Zm-1.2 18h1.7L7.3 3.8H5.5L17.7 20Z"/></svg>
  {%- when 'linkedin' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1-.02-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.82-2.05 3.75-2.05 4 0 4.4 2.5 4.4 5.8V21h-4v-5.6c0-1.34-.03-3.06-1.9-3.06-1.9 0-2.2 1.46-2.2 2.96V21H9V9Z"/></svg>
  {%- when 'youtube' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M23 12s0-3.2-.4-4.7a2.9 2.9 0 0 0-2-2C18.9 5 12 5 12 5s-6.9 0-8.6.3a2.9 2.9 0 0 0-2 2C1 8.8 1 12 1 12s0 3.2.4 4.7c.2.9.9 1.7 2 2C5.1 19 12 19 12 19s6.9 0 8.6-.3a2.9 2.9 0 0 0 2-2C23 15.2 23 12 23 12ZM9.8 15.2V8.8L15.5 12l-5.7 3.2Z"/></svg>
  {%- when 'whatsapp' -%}
    <svg class="amoy-icon {{ cls }}" viewBox="0 0 32 32" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false"><path d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.4.7 4.6 1.8 6.5L4 29l7.2-1.9c1.8 1 3.9 1.6 6 1.6 7 0 12.5-5.5 12.5-12.5S23 3 16 3Zm0 22.7c-1.9 0-3.7-.5-5.3-1.5l-.4-.2-4.3 1.1 1.1-4.2-.2-.4c-1-1.6-1.6-3.5-1.6-5.5C5 9.7 9.9 4.9 16 4.9S27 9.7 27 15.5 22.1 25.7 16 25.7Zm6.1-7.6c-.3-.2-2-1-2.3-1.1-.3-.1-.5-.2-.8.2-.2.3-.9 1.1-1.1 1.3-.2.2-.4.3-.7.1-1.9-.9-3.1-1.7-4.4-3.8-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.6-.1-.2-.8-1.9-1.1-2.6-.3-.7-.6-.6-.8-.6h-.7c-.2 0-.6.1-.9.4-.3.3-1.2 1.2-1.2 2.9s1.2 3.4 1.4 3.6c.2.2 2.5 3.9 6.1 5.4 2.3 1 3.2 1.1 4.3.9.7-.1 2-.8 2.3-1.6.3-.8.3-1.5.2-1.6-.1-.2-.3-.3-.6-.4Z"/></svg>
