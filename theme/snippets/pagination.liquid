{%- comment -%}
  Flat pagination links for collection and search pages.

  Accepts:
  - paginate: {Object} the paginate object (required)
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav class="amoy-pagination" role="navigation" aria-label="{{ 'general.pagination' | t }}">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">&lsaquo;</a>
    {%- endif -%}
    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}">{{ part.title }}</a>
      {%- elsif part.title == paginate.current_page -%}
        <span class="current" aria-current="page">{{ part.title }}</span>
      {%- else -%}
        <span class="gap">{{ part.title }}</span>
      {%- endif -%}
    {%- endfor -%}
    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">&rsaquo;</a>
    {%- endif -%}
  </nav>
{%- endif -%}
