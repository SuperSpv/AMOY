{%- comment -%} Storefront password page — shown when the store is password protected. {%- endcomment -%}
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:40px 24px;background:var(--paper)">
  <div style="max-width:440px;width:100%;text-align:center">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 500 | image_tag: style: 'max-width:200px;margin:0 auto 28px', alt: shop.name }}
    {%- else -%}
      <div class="amoy-display amoy-display--md" style="margin-bottom:24px">{{ shop.name }}</div>
    {%- endif -%}

    {%- if shop.password_message != blank -%}
      <div class="rte" style="color:var(--text-muted);font-size:15px;line-height:1.7;margin-bottom:28px">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <div style="background:#fdeceb;color:#b3261e;border-radius:var(--radius-sm);padding:12px 14px;margin-bottom:16px;font-size:13.5px">
          {{ form.errors.messages['form'] }}
        </div>
      {%- endif -%}
      <label class="amoy-visually-hidden" for="StorefrontPassword">{{ 'password.label' | t }}</label>
      <input class="amoy-input" id="StorefrontPassword" type="password" name="password" placeholder="{{ 'password.label' | t }}" autocomplete="current-password" style="background:var(--white);text-align:center">
      <button type="submit" class="amoy-btn amoy-btn--primary amoy-btn--full" style="margin-top:12px">{{ 'password.enter' | t }}</button>
    {%- endform -%}

    {%- if settings.contact_email != blank -%}
      <p style="margin-top:28px;font-size:13px;color:var(--text-faint)">
        <a href="mailto:{{ settings.contact_email }}" style="color:var(--accent);font-weight:600">{{ settings.contact_email }}</a>
      </p>
    {%- endif -%}
  </div>
</div>
