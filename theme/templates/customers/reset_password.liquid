{{ 'customer.css' | asset_url | stylesheet_tag }}
<div class="amoy-customer amoy-customer--narrow">
  <h1 class="amoy-display amoy-display--md amoy-customer__title">Reset your password</h1>
  {%- form 'reset_customer_password' -%}
    {%- if form.errors -%}<div class="amoy-customer__errors">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="amoy-customer__field">
      <label class="amoy-label" for="ResetPassword">New password</label>
      <input class="amoy-input" type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
    </div>
    <div class="amoy-customer__field">
      <label class="amoy-label" for="ResetPasswordConfirm">Confirm password</label>
      <input class="amoy-input" type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" autocomplete="new-password" required>
    </div>
    <button type="submit" class="amoy-btn amoy-btn--primary">Reset password</button>
  {%- endform -%}
</div>
