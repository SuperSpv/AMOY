{{ 'customer.css' | asset_url | stylesheet_tag }}
<div class="amoy-customer">
  <div class="amoy-eyebrow">{{ 'customer.account' | t }}</div>
  <h1 class="amoy-display amoy-display--md amoy-customer__title">{{ customer.first_name | default: customer.email }}</h1>

  <div class="amoy-customer__grid">
    <div>
      <h2 style="font-family:var(--font-display);font-size:24px;font-weight:600;margin-bottom:16px">{{ 'customer.orders' | t }}</h2>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="amoy-customer__table">
            <thead>
              <tr>
                <th>{{ 'customer.order_number' | t }}</th>
                <th>{{ 'customer.date' | t }}</th>
                <th>{{ 'customer.payment_status' | t }}</th>
                <th>{{ 'customer.fulfillment_status' | t }}</th>
                <th>{{ 'customer.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}" class="amoy-customer__link">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: format: 'date' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- if paginate.pages > 1 -%}
            <nav class="amoy-pagination" style="margin-top:24px">{{ paginate | default_pagination }}</nav>
          {%- endif -%}
        {%- else -%}
          <p style="color:var(--text-muted)">{{ 'customer.no_orders' | t }}</p>
        {%- endif -%}
      {%- endpaginate -%}
    </div>

    <aside class="amoy-customer__card">
      <h2 style="font-family:var(--font-display);font-size:20px;font-weight:600;margin-bottom:12px">{{ 'customer.addresses' | t }}</h2>
      {%- if customer.default_address -%}
        <address class="amoy-customer__address">{{ customer.default_address | format_address }}</address>
      {%- endif -%}
      <a href="{{ routes.account_addresses_url }}" class="amoy-customer__link" style="display:inline-block;margin-top:12px">Manage addresses</a>
      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border-subtle)">
        <a href="{{ routes.account_logout_url }}" class="amoy-customer__link">{{ 'customer.log_out' | t }}</a>
      </div>
    </aside>
  </div>
</div>
