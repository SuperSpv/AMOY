{{ 'amoy-blog.css' | asset_url | stylesheet_tag }}
<article class="article-page">
  <div class="article-hero"><div class="article-hero-inner"><a href="{{ blog.url }}" class="back-btn">&larr; Back to {{ blog.title }}</a>{%- if article.tags.size > 0 -%}<span class="article-category">{{ article.tags.first }}</span>{%- endif -%}<h1 class="article-title">{{ article.title }}</h1><div class="article-meta"><span>{{ article.published_at | date: '%B %d, %Y' }}</span><span class="meta-sep"></span>{%- assign words = article.content | strip_html | number_of_words -%}{%- assign read_time = words | divided_by: 200 | plus: 1 -%}<span>{{ read_time }} min read</span>{%- if article.author != blank -%}<span class="meta-sep"></span><span>By {{ article.author }}</span>{%- endif -%}</div></div></div>
  {%- if article.image -%}<div class="article-cover"><img src="{{ article.image | image_url: width: 1280 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="1280" height="488" class="article-cover-img" loading="eager"></div>{%- endif -%}
  <div class="article-body-wrap"><div class="article-body rte">{{ article.content }}</div>{%- if article.tags.size > 0 -%}<div class="article-tags"><span class="tags-label">Tags:</span>{%- for tag in article.tags -%}<a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="tag-chip">{{ tag }}</a>{%- endfor -%}</div>{%- endif -%}{%- if section.settings.show_related and blog.articles.size > 1 -%}<div class="related-posts"><div class="related-label">More from AMOY Insights</div><div class="related-grid">{%- for related in blog.articles -%}{%- unless related.id == article.id -%}{%- if forloop.index <= 3 -%}{%- render 'blog-card', article: related -%}{%- endif -%}{%- endunless -%}{%- endfor -%}</div></div>{%- endif -%}</div>
</article>
{% schema %}{"name":"Article","settings":[{"type":"checkbox","id":"show_related","label":"Show related posts","default":true}]}{% endschema %}