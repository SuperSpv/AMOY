{{ 'amoy-blog.css' | asset_url | stylesheet_tag }}
<section class="amoy-latest-blogs" style="background:var(--paper);padding:80px 32px">
  <div style="max-width:var(--container-max);margin:0 auto">
    <div class="eyebrow">{{ section.settings.eyebrow | default: 'AMOY Insights' }}</div>
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px;margin-top:12px;flex-wrap:wrap;gap:16px">
      <h2 style="font-family:var(--font-display);font-size:2.5rem;font-weight:500;line-height:1.1;letter-spacing:-.02em;color:var(--navy-700);margin:0">{{ section.settings.heading | default: 'From the journal.' }}</h2>
      <a href="/blogs/news" class="read-more">View all posts &rarr;</a>
    </div>
    {%- assign blog_handle = section.settings.blog | default: 'news' -%}
    {%- assign target_blog = blogs[blog_handle] -%}
    {%- if target_blog and target_blog.articles_count > 0 -%}
      <div class="posts-grid">
        {%- for article in target_blog.articles limit: section.settings.post_count -%}
          {%- render 'blog-card', article: article -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:var(--slate);text-align:center;padding:48px 0">No posts yet - check back soon.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Latest Blog Posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow label", "default": "AMOY Insights" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_count", "min": 2, "max": 6, "step": 1, "label": "Number of posts", "default": 3 }
  ],
  "presets": [{ "name": "Latest Blog Posts" }]
}
{% endschema %}