{{ 'amoy-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign target_blog = blogs[section.settings.blog]
  if target_blog == blank
    assign target_blog = blogs.news
  endif
-%}

<section class="amoy-latest-blogs amoy-block" style="background:var(--paper)">
  <div class="amoy-container">
    {%- if section.settings.eyebrow != blank -%}
      <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin:16px 0 40px;flex-wrap:wrap;gap:16px">
      <h2 class="amoy-display amoy-display--md" style="margin:0">{{ section.settings.heading }}</h2>
      {%- if target_blog != blank -%}
        <a href="{{ target_blog.url }}" class="read-more">{{ 'blog.view_all_posts' | t }} &rarr;</a>
      {%- endif -%}
    </div>

    {%- if target_blog != blank and target_blog.articles_count > 0 -%}
      <div class="posts-grid">
        {%- for article in target_blog.articles limit: section.settings.post_count -%}
          {%- render 'blog-card', article: article -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p style="color:var(--text-muted);text-align:center;padding:48px 0">{{ 'blog.no_posts' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Latest blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "AMOY Insights" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "From the journal." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "post_count", "min": 2, "max": 6, "step": 1, "label": "Number of posts", "default": 3 }
  ],
  "presets": [{ "name": "Latest blog posts" }]
}
{% endschema %}
