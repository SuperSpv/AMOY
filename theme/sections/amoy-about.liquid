<div>
  <section class="amoy-container" style="padding-top:56px;padding-bottom:80px">
    <div style="max-width:760px">
      <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
      <h1 class="amoy-display amoy-display--xl" style="margin:20px 0 0">{{ section.settings.heading }}</h1>
      <p style="font-size:18px;line-height:1.7;color:var(--text-muted);margin:26px 0 0;max-width:58ch">{{ section.settings.body }}</p>
    </div>
    <div class="amoy-grid--3" style="margin-top:48px">
      {%- for block in section.blocks -%}
        <div style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;background:var(--mist)" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: widths: '400,600,900', sizes: '(min-width: 769px) 33vw, 100vw', style: 'width:100%;height:100%;object-fit:cover', loading: 'lazy', alt: block.settings.caption }}
          {%- else -%}
            <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" opacity=".2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
          {%- endif -%}
          <span class="amoy-media-label">{{ block.settings.caption }}</span>
        </div>
      {%- endfor -%}
    </div>
  </section>
  <section style="background:var(--white);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);padding:80px 0">
    <div class="amoy-container">
      <div class="amoy-eyebrow">{{ section.settings.process_eyebrow }}</div>
      <div class="amoy-grid--3" style="gap:32px;margin-top:32px">
        {%- for i in (1..3) -%}
          {%- assign t_key = 'step' | append: i | append: '_title' -%}
          {%- assign b_key = 'step' | append: i | append: '_body' -%}
          {%- if section.settings[t_key] != blank -%}
            <div style="display:flex;gap:18px"><div style="font-family:var(--font-display);font-size:32px;font-weight:600;color:var(--silver);line-height:1;flex:none">0{{ i }}</div><div><h3 style="font-size:18px;font-weight:600;color:var(--text-heading);margin:0 0 7px">{{ section.settings[t_key] }}</h3><p style="font-size:14px;line-height:1.6;color:var(--text-muted)">{{ section.settings[b_key] }}</p></div></div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "About",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About AMOY"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "We create characters, not just forms."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "AMOY Limited is Saudi Arabia's premier fiberglass mannequin manufacturer, based in Jeddah. From luxury to sportswear, we craft mannequins that hold a pose — and a brand's identity — with quiet confidence."
    },
    {
      "type": "text",
      "id": "process_eyebrow",
      "label": "Process eyebrow",
      "default": "How we work"
    },
    {
      "type": "text",
      "id": "step1_title",
      "label": "Step 1 title",
      "default": "Design & sculpt"
    },
    {
      "type": "textarea",
      "id": "step1_body",
      "label": "Step 1 text",
      "default": "Forms developed to fit your brand's identity and silhouette."
    },
    {
      "type": "text",
      "id": "step2_title",
      "label": "Step 2 title",
      "default": "Finish to spec"
    },
    {
      "type": "textarea",
      "id": "step2_body",
      "label": "Step 2 text",
      "default": "Semi-matte white by default, or any custom colour and finish."
    },
    {
      "type": "text",
      "id": "step3_title",
      "label": "Step 3 title",
      "default": "Deliver across KSA"
    },
    {
      "type": "textarea",
      "id": "step3_body",
      "label": "Step 3 text",
      "default": "Riyadh, Jeddah, Dammam and every city between."
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "atelier · sculpting"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About",
      "blocks": [
        {
          "type": "gallery_image",
          "settings": {
            "caption": "atelier · sculpting"
          }
        },
        {
          "type": "gallery_image",
          "settings": {
            "caption": "finishing · semi-matte"
          }
        },
        {
          "type": "gallery_image",
          "settings": {
            "caption": "window · installed"
          }
        }
      ]
    }
  ]
}
{% endschema %}
