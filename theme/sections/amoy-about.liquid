<div>
  <section style="max-width:var(--container-max);margin:0 auto;padding:56px 40px 80px">
    <div style="max-width:760px">
      <div class="amoy-eyebrow">About AMOY</div>
      <h1 class="amoy-display amoy-display--xl" style="margin:20px 0 0">{{ section.settings.heading }}</h1>
      <p style="font-size:18px;line-height:1.7;color:var(--text-muted);margin:26px 0 0;max-width:58ch">{{ section.settings.body }}</p>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px">
      {%- for block in section.blocks -%}
        <div style="position:relative;height:300px;border-radius:var(--radius-lg);overflow:hidden;background:var(--mist)" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag: style: 'width:100%;height:100%;object-fit:cover', loading: 'lazy' }}
          {%- else -%}
            <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" opacity=".2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
          {%- endif -%}
          <span class="amoy-media-label">{{ block.settings.caption }}</span>
        </div>
      {%- endfor -%}
    </div>
  </section>
  <section style="background:var(--white);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle);padding:80px 0">
    <div style="max-width:var(--container-max);margin:0 auto;padding:0 40px">
      <div class="amoy-eyebrow">{{ section.settings.process_eyebrow }}</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:32px;margin-top:32px">
        <div style="display:flex;gap:18px"><div style="font-family:var(--font-display);font-size:32px;font-weight:600;color:var(--silver);line-height:1;flex:none">01</div><div><h3 style="font-size:18px;font-weight:600;color:var(--text-heading);margin:0 0 7px">Design & sculpt</h3><p style="font-size:14px;line-height:1.6;color:var(--text-muted)">Forms developed to fit your brand's identity and silhouette.</p></div></div>
        <div style="display:flex;gap:18px"><div style="font-family:var(--font-display);font-size:32px;font-weight:600;color:var(--silver);line-height:1;flex:none">02</div><div><h3 style="font-size:18px;font-weight:600;color:var(--text-heading);margin:0 0 7px">Finish to spec</h3><p style="font-size:14px;line-height:1.6;color:var(--text-muted)">Semi-matte white by default, or any custom colour and finish.</p></div></div>
        <div style="display:flex;gap:18px"><div style="font-family:var(--font-display);font-size:32px;font-weight:600;color:var(--silver);line-height:1;flex:none">03</div><div><h3 style="font-size:18px;font-weight:600;color:var(--text-heading);margin:0 0 7px">Deliver across KSA</h3><p style="font-size:14px;line-height:1.6;color:var(--text-muted)">Riyadh, Jeddah, Dammam and every city between.</p></div></div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{"name":"About","settings":[{"type":"textarea","id":"heading","label":"Heading","default":"We create characters, not just forms."},{"type":"textarea","id":"body","label":"Body","default":"AMOY Limited is Saudi Arabia's premier fiberglass mannequin manufacturer, based in Jeddah. From luxury to sportswear, we craft mannequins that hold a pose — and a brand's identity — with quiet confidence."},{"type":"text","id":"process_eyebrow","label":"Process eyebrow","default":"How we work"}],"blocks":[{"type":"gallery_image","name":"Gallery image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"caption","label":"Caption","default":"atelier · sculpting"}]}],"presets":[{"name":"About","blocks":[{"type":"gallery_image","settings":{"caption":"atelier · sculpting"}},{"type":"gallery_image","settings":{"caption":"finishing · semi-matte"}},{"type":"gallery_image","settings":{"caption":"window · installed"}}]}]}
{% endschema %}