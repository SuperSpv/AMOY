<style>
  .kids-hero__media{position:relative;overflow:hidden;background:var(--mist);border-radius:var(--radius-lg)}
</style>
<section class="amoy-block" style="padding-top:56px;padding-bottom:64px">
  <div class="amoy-container">
    <div class="amoy-grid--split" style="align-items:center">
      <div>
        <div class="amoy-eyebrow amoy-eyebrow--brass">{{ section.settings.eyebrow }}</div>
        <h1 class="amoy-display amoy-display--xl" style="margin:18px 0 0">{{ section.settings.heading }}</h1>
        <p style="font-size:17px;line-height:1.75;color:var(--text-body);margin:22px 0 0;max-width:48ch">{{ section.settings.intro }}</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:30px">
          {%- liquid
            assign hero_wa = section.settings.whatsapp_url
            if hero_wa == blank and settings.whatsapp_number != blank
              assign hero_wa = 'https://wa.me/' | append: settings.whatsapp_number
            endif
          -%}
          {%- if hero_wa != blank -%}
            <a href="{{ hero_wa }}" target="_blank" rel="noopener" class="amoy-btn amoy-btn--primary amoy-btn--lg">{{ section.settings.quote_label }}</a>
          {%- endif -%}
          {%- if section.settings.contact_label != blank -%}
            {%- capture hero_contact_url -%}{% render 'amoy-url', url: section.settings.contact_url, fallback: '/pages/contact' %}{%- endcapture -%}
            <a href="{{ hero_contact_url }}" class="amoy-btn amoy-btn--secondary amoy-btn--lg">{{ section.settings.contact_label }}</a>
          {%- endif -%}
        </div>
      </div>
      <div class="kids-hero__media" style="min-height:460px;box-shadow:var(--shadow-sm)">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: style: 'width:100%;height:100%;object-fit:cover', loading: 'eager', alt: section.settings.eyebrow }}
        {%- elsif collection.image != blank -%}
          {{ collection.image | image_url: width: 1200 | image_tag: style: 'width:100%;height:100%;object-fit:cover', loading: 'eager', alt: collection.image.alt | default: collection.title }}
        {%- elsif collection.products.first.featured_media != blank -%}
          {{ collection.products.first.featured_media | image_url: width: 1200 | image_tag: style: 'width:100%;height:100%;object-fit:contain;padding:24px', loading: 'eager', alt: collection.title }}
        {%- else -%}
          <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="52" height="52" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15l5-4 4 3 5-5 4 4"/></svg></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Kids · Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Kids Collection"},{"type":"text","id":"heading","label":"Heading","default":"Kids"},{"type":"textarea","id":"intro","label":"Intro paragraph","default":"The Kids Collection by AMOY brings playful precision to children's retail displays. Lightweight, durable fiberglass forms designed to showcase childrenswear beautifully — from toddler sizes to teens."},{"type":"url","id":"whatsapp_url","label":"WhatsApp URL","info":"Leave blank to use the WhatsApp number from Theme settings → Contact & social."},{"type":"text","id":"contact_label","label":"Second button label","default":"Contact us"},{"type":"url","id":"contact_url","label":"Second button link"},{"type":"text","id":"quote_label","label":"Quote button label","default":"Request quotation"},{"type":"image_picker","id":"hero_image","label":"Hero image"}],"presets":[{"name":"Kids · Hero"}]}
{% endschema %}