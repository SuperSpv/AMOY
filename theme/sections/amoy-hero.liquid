<section style="padding:clamp(28px,6vw,64px) 0 clamp(52px,9vw,96px)">
  <div class="amoy-container">
    <div class="amoy-grid--split">
      <div>
        <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
        <h1 class="amoy-display amoy-display--xl" style="margin:clamp(16px,2.5vw,22px) 0 0">{{ section.settings.heading_line1 }}<br><em style="font-style:italic;color:var(--brass-600)">{{ section.settings.heading_em }}</em> {{ section.settings.heading_line2 }}</h1>
        <p style="font-size:clamp(16px,15px + .4vw,18px);line-height:1.65;color:var(--text-muted);max-width:44ch;margin:clamp(18px,3vw,26px) 0 0">{{ section.settings.subheading }}</p>
        <div class="amoy-hero__btns" style="display:flex;gap:clamp(10px,1.5vw,14px);margin-top:clamp(24px,4vw,34px);flex-wrap:wrap">
          {%- capture hero_primary_url -%}{% render 'amoy-url', url: section.settings.primary_url, fallback: routes.all_products_collection_url %}{%- endcapture -%}
          {%- capture hero_secondary_url -%}{% render 'amoy-url', url: section.settings.secondary_url, fallback: routes.root_url %}{%- endcapture -%}
          {%- if section.settings.primary_label != blank -%}
            <a href="{{ hero_primary_url }}" class="amoy-btn amoy-btn--primary amoy-btn--lg">{{ section.settings.primary_label }}</a>
          {%- endif -%}
          {%- if section.settings.secondary_label != blank -%}
            <a href="{{ hero_secondary_url }}" class="amoy-btn amoy-btn--secondary amoy-btn--lg">{{ section.settings.secondary_label }}</a>
          {%- endif -%}
        </div>
        <div style="display:flex;gap:clamp(20px,4vw,44px);margin-top:clamp(32px,6vw,52px);flex-wrap:wrap">
          {%- for block in section.blocks -%}
            <div {{ block.shopify_attributes }}>
              <div class="amoy-ltr" style="font-family:var(--font-display);font-size:clamp(26px,18px + 2vw,36px);font-weight:600;color:var(--text-heading);line-height:1">{{ block.settings.value }}</div>
              <div style="font-size:12.5px;color:var(--text-muted);margin-top:6px">{{ block.settings.label }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
      <div class="amoy-hero__media" style="position:relative;border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-md);background:var(--mist)">
        {%- if section.settings.image != blank -%}
          {%- if request.locale.iso_code == 'ar' -%}{%- assign img_alt = 'مانيكان عرض ملابس فايبر جلاس من أموي AMOY' -%}{%- else -%}{%- assign img_alt = 'AMOY fiberglass display mannequins' -%}{%- endif -%}
          {%- assign img_alt_final = section.settings.image.alt | default: img_alt -%}{%- if request.locale.iso_code == 'ar' -%}{%- assign img_alt_final = img_alt -%}{%- endif -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: alt: img_alt_final, loading: 'eager', fetchpriority: 'high', widths: '500,700,900,1100,1400', sizes: '(min-width: 769px) 50vw, 100vw', style: 'width:100%;height:100%;object-fit:cover' }}
        {%- else -%}
          <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="64" height="64" fill="none" stroke="currentColor" stroke-width="1" opacity=".2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9l3-3m0 0h3m-3 0v3M21 15l-3 3m0 0h-3m3 0v-3"/></svg></div>
        {%- endif -%}
        <div style="position:absolute;inset-inline-start:clamp(12px,2vw,20px);top:clamp(12px,2vw,20px)"><span class="amoy-badge amoy-badge--certified"><span class="amoy-badge__dot"></span>{{ 'general.certified_badge' | t }}</span></div>
        <span class="amoy-media-label">{{ section.settings.image_caption }}</span>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"AMOY Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Fiberglass Mannequins · Jeddah, KSA"},{"type":"text","id":"heading_line1","label":"Heading line 1","default":"Elegance in"},{"type":"text","id":"heading_em","label":"Italic word","default":"every"},{"type":"text","id":"heading_line2","label":"Heading line 2","default":"curve."},{"type":"textarea","id":"subheading","label":"Subheading","default":"High-quality fiberglass mannequins for fashion brands and visual merchandisers across the Kingdom — buy online, or request a bespoke quote for your store concept."},{"type":"text","id":"primary_label","label":"Primary button","default":"Shop the collection"},{"type":"url","id":"primary_url","label":"Primary URL"},{"type":"text","id":"secondary_label","label":"Secondary button","default":"Our story"},{"type":"url","id":"secondary_url","label":"Secondary URL"},{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"image_caption","label":"Image caption","default":"Grace 04 · semi-matte white"}],"blocks":[{"type":"stat","name":"Stat","settings":[{"type":"text","id":"value","label":"Value","default":"13+"},{"type":"text","id":"label","label":"Label","default":"Years of craft"}]}],"presets":[{"name":"AMOY Hero","blocks":[{"type":"stat","settings":{"value":"13+","label":"Years of craft"}},{"type":"stat","settings":{"value":"3","label":"Cities served"}},{"type":"stat","settings":{"value":"100%","label":"KSA-made fiberglass"}}]}]}
{% endschema %}