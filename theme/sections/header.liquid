{%- liquid
  assign is_ar = false
  if request.locale.iso_code contains 'ar'
    assign is_ar = true
  endif
-%}
<style>
  #main-content{padding-top:96px}
  .amoy-header{position:fixed;top:0;left:0;right:0;width:100%;height:96px;background:rgba(251,251,253,.94);backdrop-filter:saturate(120%) blur(6px);-webkit-backdrop-filter:saturate(120%) blur(6px);box-shadow:0 1px 0 rgba(28,27,77,.07),0 6px 24px rgba(28,27,77,.05);border-bottom:none;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:0 40px;z-index:100}
  .amoy-header__logo{height:58px;width:auto}
  .amoy-header__nav{display:flex;align-items:center;gap:30px}
  .amoy-header__nav-link{font-size:14px;font-weight:600;color:var(--text-body);position:relative}
  .amoy-header__nav-link:hover{color:var(--accent)}
  .amoy-header__right{display:flex;align-items:center;gap:16px}
  .amoy-header__search{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--border-default);border-radius:999px;padding:7px 14px;background:var(--white)}
  .amoy-header__search:focus-within{border-color:var(--accent)}
  .amoy-header__search svg{color:var(--text-muted);flex:none}
  .amoy-header__search input{border:none;background:none;font:inherit;font-size:13px;width:130px;outline:none;color:var(--text-body)}
  .amoy-lang{display:inline-flex;border:1px solid var(--border-default);border-radius:999px;overflow:hidden}
  .amoy-lang button{background:none;border:none;cursor:pointer;font:inherit;font-size:12.5px;font-weight:700;padding:6px 12px;color:var(--text-muted)}
  .amoy-lang button.is-active{background:var(--accent);color:var(--accent-on);}
  .amoy-header__cart{display:inline-flex;align-items:center;gap:7px;font-size:14px;font-weight:600;color:var(--text-body);position:relative}
  .amoy-header__cart-count{background:#B08A22;color:#fff;font-size:11px;font-weight:700;min-width:18px;height:18px;border-radius:999px;display:inline-flex;align-items:center;justify-content:center;padding:0 5px}
  .amoy-burger{display:none;width:42px;height:42px;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--white);cursor:pointer;align-items:center;justify-content:center;color:var(--text-heading)}
  .amoy-mobile-nav{position:fixed;inset:0;z-index:200;visibility:hidden;opacity:0;transition:opacity .2s}
  .amoy-mobile-nav.is-open{visibility:visible;opacity:1}
  .amoy-mobile-nav__backdrop{position:absolute;inset:0;background:var(--overlay-scrim)}
  .amoy-mobile-nav__panel{position:absolute;top:0;bottom:0;right:0;width:300px;max-width:86vw;background:var(--white);padding:22px;display:flex;flex-direction:column;gap:6px;transform:translateX(105%);transition:transform .26s cubic-bezier(.23,1,.32,1);overflow-y:auto}
  [dir=rtl] .amoy-mobile-nav__panel{right:auto;left:0;transform:translateX(-105%)}
  .amoy-mobile-nav.is-open .amoy-mobile-nav__panel{transform:translateX(0)}
  .amoy-mobile-nav__search{display:flex;gap:8px;margin:2px 0 14px}
  .amoy-mobile-nav__search input{flex:1;font:inherit;font-size:15px;padding:11px 14px;border:1px solid var(--border-default);border-radius:999px;background:var(--white);color:var(--text-body);outline:none}
  .amoy-mobile-nav__search input:focus{border-color:var(--accent)}
  .amoy-mobile-nav__search button{flex:none;width:46px;display:inline-flex;align-items:center;justify-content:center;padding:0}
  .amoy-mobile-nav__link{font-family:var(--font-display);font-size:22px;font-weight:600;color:var(--text-heading);padding:12px 4px;border-bottom:1px solid var(--border-subtle)}
  @media(max-width:860px){
    .amoy-header{height:74px;padding:0 18px}
    #main-content{padding-top:74px}
    .amoy-header__logo{height:44px}
    .amoy-header__nav{display:none}
    .amoy-header__search{display:none}
    .amoy-header__cart span:not(.amoy-header__cart-count){display:none}
    .amoy-burger{display:inline-flex}
  }
</style>
<header class="amoy-header" id="shopify-section-{{ section.id }}">
  <a href="{{ routes.root_url }}" class="amoy-header__logo-wrap" aria-label="{{ shop.name }}">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 500 | image_tag: class: 'amoy-header__logo', height: 58, loading: 'eager', alt: shop.name }}
    {%- else -%}
      <span style="font-family:var(--font-display);font-size:30px;font-weight:600;color:var(--navy-700);letter-spacing:-.02em">{{ shop.name }}</span>
    {%- endif -%}
  </a>
  <nav class="amoy-header__nav" aria-label="Main navigation">
    <a href="{{ routes.root_url }}" class="amoy-header__nav-link">{% if is_ar %}الرئيسية{% else %}Home{% endif %}</a>
    <a href="{{ routes.all_products_collection_url }}" class="amoy-header__nav-link">{% if is_ar %}المتجر{% else %}Shop{% endif %}</a>
    <a href="/blogs/news" class="amoy-header__nav-link">{% if is_ar %}المدوّنة{% else %}Blog{% endif %}</a>
    <a href="/pages/about" class="amoy-header__nav-link">{% if is_ar %}من نحن{% else %}About{% endif %}</a>
    <a href="/pages/contact" class="amoy-header__nav-link">{% if is_ar %}تواصل{% else %}Contact{% endif %}</a>
  </nav>
  <div class="amoy-header__right">
    <form action="{{ routes.search_url }}" method="get" role="search" class="amoy-header__search">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
      <input type="search" name="q" placeholder="{% if is_ar %}بحث{% else %}Search{% endif %}" aria-label="{% if is_ar %}بحث{% else %}Search{% endif %}">
    </form>
    {%- if localization.available_languages.size > 1 -%}
      {%- form 'localization' -%}
        <div class="amoy-lang">
          {%- for language in localization.available_languages -%}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="{% if language.iso_code == localization.language.iso_code %}is-active{% endif %}">{{ language.iso_code | upcase }}</button>
          {%- endfor -%}
        </div>
      {%- endform -%}
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="amoy-header__cart" aria-label="Cart ({{ cart.item_count }} items)">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h2l2.5 13h11l2-9H6"/><path d="M9 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/><path d="M17 21a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"/></svg>
      <span>{% if is_ar %}السلة{% else %}Cart{% endif %}</span>
      <span class="amoy-header__cart-count" data-cart-count style="{% unless cart.item_count > 0 %}display:none{% endunless %}">{{ cart.item_count }}</span>
    </a>
    <button type="button" class="amoy-burger" data-menu-toggle aria-label="Menu"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  </div>
</header>
<div class="amoy-mobile-nav" data-mobile-nav>
  <div class="amoy-mobile-nav__backdrop" data-menu-backdrop></div>
  <div class="amoy-mobile-nav__panel">
    <button type="button" data-menu-close aria-label="Close" style="align-self:flex-end;width:38px;height:38px;border:1px solid var(--border-default);border-radius:var(--radius-sm);background:var(--white);cursor:pointer;color:var(--text-heading);display:inline-flex;align-items:center;justify-content:center;margin-bottom:8px"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    <form action="{{ routes.search_url }}" method="get" role="search" class="amoy-mobile-nav__search">
      <input type="search" name="q" placeholder="{% if is_ar %}ابحث في المتجر{% else %}Search the store{% endif %}" aria-label="{% if is_ar %}بحث{% else %}Search{% endif %}">
      <button type="submit" class="amoy-btn amoy-btn--primary" aria-label="{% if is_ar %}بحث{% else %}Search{% endif %}"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg></button>
    </form>
    <a href="{{ routes.root_url }}" class="amoy-mobile-nav__link">{% if is_ar %}الرئيسية{% else %}Home{% endif %}</a>
    <a href="{{ routes.all_products_collection_url }}" class="amoy-mobile-nav__link">{% if is_ar %}المتجر{% else %}Shop{% endif %}</a>
    <a href="/blogs/news" class="amoy-mobile-nav__link">{% if is_ar %}المدوّنة{% else %}Blog{% endif %}</a>
    <a href="/pages/about" class="amoy-mobile-nav__link">{% if is_ar %}من نحن{% else %}About{% endif %}</a>
    <a href="/pages/contact" class="amoy-mobile-nav__link">{% if is_ar %}تواصل معنا{% else %}Contact{% endif %}</a>
    {%- if localization.available_languages.size > 1 -%}
      {%- form 'localization' -%}
        <div class="amoy-lang" style="margin-top:18px;align-self:flex-start">
          {%- for language in localization.available_languages -%}
            <button type="submit" name="locale_code" value="{{ language.iso_code }}" class="{% if language.iso_code == localization.language.iso_code %}is-active{% endif %}">{{ language.endonym_name }}</button>
          {%- endfor -%}
        </div>
      {%- endform -%}
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" }
  ]
}
{% endschema %}
