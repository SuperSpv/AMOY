{{ 'section-header.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign menu = section.settings.menu
  assign logo = section.settings.logo | default: settings.logo
  assign logo_w = section.settings.logo_width | default: settings.logo_width
  assign cart_is_drawer = false
  if settings.cart_type == 'drawer'
    assign cart_is_drawer = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} {
    --header-logo-w: {{ logo_w }}px;
    --header-h: {{ section.settings.header_height }}px;
    --header-bg: {{ section.settings.background_color }};
    --header-fg: {{ section.settings.text_color }};
  }
</style>

<header class="amoy-header{% if section.settings.sticky %} amoy-header--sticky{% endif %}" data-header role="banner">
  <div class="amoy-header__inner">
    <button
      type="button"
      class="amoy-header__burger"
      data-menu-toggle
      aria-controls="AmoyMobileNav"
      aria-expanded="false"
      aria-label="{{ 'accessibility.open_menu' | t }}"
    >{% render 'icon', icon: 'menu', size: 22 %}</button>

    <div class="amoy-header__logo-wrap">
      <a href="{{ routes.root_url }}" class="amoy-header__logo-link" aria-label="{{ shop.name }}">
        {%- if logo != blank -%}
          {{
            logo
            | image_url: width: 600
            | image_tag:
              class: 'amoy-header__logo',
              widths: '160,220,320,440,600',
              sizes: '(max-width: 860px) 160px, 220px',
              loading: 'eager',
              alt: shop.name
          }}
        {%- else -%}
          <span class="amoy-header__wordmark">{{ shop.name }}</span>
        {%- endif -%}
      </a>
    </div>

    {%- if menu != blank and linklists[menu].links.size > 0 -%}
      <nav class="amoy-header__nav" aria-label="{{ 'accessibility.main_navigation' | t }}">
        <ul class="amoy-header__nav-list">
          {%- for link in linklists[menu].links -%}
            <li class="amoy-header__nav-item">
              {%- if link.links.size > 0 -%}
                <details class="amoy-dropdown" data-dropdown>
                  <summary class="amoy-header__nav-link{% if link.active or link.child_active %} is-active{% endif %}">
                    {{ link.title | escape }}
                    {% render 'icon', icon: 'chevron-down', size: 14, class: 'amoy-header__caret' %}
                  </summary>
                  <div class="amoy-dropdown__panel">
                    <ul class="amoy-dropdown__list">
                      {%- for child in link.links -%}
                        <li>
                          <a href="{{ child.url }}" class="amoy-dropdown__link{% if child.active %} is-active{% endif %}">{{ child.title | escape }}</a>
                          {%- if child.links.size > 0 -%}
                            <ul class="amoy-dropdown__sublist">
                              {%- for grandchild in child.links -%}
                                <li><a href="{{ grandchild.url }}" class="amoy-dropdown__sublink">{{ grandchild.title | escape }}</a></li>
                              {%- endfor -%}
                            </ul>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
              {%- else -%}
                <a href="{{ link.url }}" class="amoy-header__nav-link{% if link.active %} is-active{% endif %}">{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="amoy-header__right">
      {%- if section.settings.show_search -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="amoy-header__search">
          <input type="hidden" name="options[prefix]" value="last">
          {% render 'icon', icon: 'search', size: 16 %}
          <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.label' | t }}" aria-label="{{ 'search.label' | t }}">
        </form>
      {%- endif -%}

      {%- if section.settings.show_localization -%}
        {%- render 'localization-form', context: 'header' -%}
      {%- endif -%}

      {%- if shop.customer_accounts_enabled and section.settings.show_account -%}
        <a
          href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
          class="amoy-header__icon-link"
          aria-label="{{ 'customer.account' | t }}"
        >{% render 'icon', icon: 'account', size: 19 %}</a>
      {%- endif -%}

      <a
        href="{{ routes.cart_url }}"
        class="amoy-header__cart"
        {% if cart_is_drawer %}data-cart-drawer-open aria-haspopup="dialog"{% endif %}
        aria-label="{{ 'accessibility.cart_count' | t: count: cart.item_count }}"
      >
        {% render 'icon', icon: 'cart', size: 18 %}
        <span class="amoy-header__cart-label">{{ 'cart.title' | t }}</span>
        <span class="amoy-header__cart-count" data-cart-count {% unless cart.item_count > 0 %}hidden{% endunless %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- for block in section.blocks -%}
    {%- case block.type -%}
      {%- when '@app' -%}
        <div class="amoy-header__app-block" {{ block.shopify_attributes }}>{% render block %}</div>
    {%- endcase -%}
  {%- endfor -%}
</header>

<div class="amoy-mobile-nav" id="AmoyMobileNav" data-mobile-nav>
  <div class="amoy-mobile-nav__backdrop" data-menu-close></div>
  <div class="amoy-mobile-nav__panel" role="dialog" aria-modal="true" aria-label="{{ 'general.menu' | t }}">
    <div class="amoy-mobile-nav__head">
      <span class="amoy-mobile-nav__title">{{ 'general.menu' | t }}</span>
      <button type="button" class="amoy-mobile-nav__close" data-menu-close aria-label="{{ 'accessibility.close_menu' | t }}">
        {% render 'icon', icon: 'close', size: 18 %}
      </button>
    </div>

    <form action="{{ routes.search_url }}" method="get" role="search" class="amoy-mobile-nav__search">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.label' | t }}">
      <button type="submit" class="amoy-btn amoy-btn--primary" aria-label="{{ 'search.submit' | t }}">
        {% render 'icon', icon: 'search', size: 18 %}
      </button>
    </form>

    {%- if menu != blank -%}
      <ul class="amoy-mobile-nav__list">
        {%- for link in linklists[menu].links -%}
          <li>
            {%- if link.links.size > 0 -%}
              <details class="amoy-mobile-nav__group">
                <summary class="amoy-mobile-nav__link">
                  {{ link.title | escape }}
                  {% render 'icon', icon: 'chevron-down', size: 16 %}
                </summary>
                <ul class="amoy-mobile-nav__sublist">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}" class="amoy-mobile-nav__sublink">{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              </details>
            {%- else -%}
              <a href="{{ link.url }}" class="amoy-mobile-nav__link">{{ link.title | escape }}</a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="amoy-mobile-nav__foot">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="amoy-mobile-nav__account">
          {% render 'icon', icon: 'account', size: 18 %}
          {% if customer %}{{ 'customer.account' | t }}{% else %}{{ 'customer.log_in' | t }}{% endif %}
        </a>
      {%- endif -%}
      {%- if section.settings.show_localization -%}
        {%- render 'localization-form', context: 'drawer' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Edit the links in Online Store → Navigation." },
    { "type": "header", "content": "Logo" },
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Falls back to the theme logo." },
    { "type": "range", "id": "logo_width", "min": 80, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 220 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "header_height", "min": 60, "max": 120, "step": 2, "unit": "px", "label": "Header height", "default": 78 },
    { "type": "checkbox", "id": "sticky", "label": "Stick to the top when scrolling", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FBFBFD" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1C1B4D" },
    { "type": "header", "content": "Utilities" },
    { "type": "checkbox", "id": "show_search", "label": "Show search box", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account link", "default": true, "info": "Only appears when customer accounts are enabled." },
    { "type": "checkbox", "id": "show_localization", "label": "Show language / country selector", "default": true }
  ],
  "blocks": [{ "type": "@app" }],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
