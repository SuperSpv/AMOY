<style>
  .grace-hero__media,.grace-feat__media,.grace-char__media{position:relative;overflow:hidden;background:var(--mist)}
  .grace-hero__media{border-radius:var(--radius-lg)}
  .grace-feat__media{height:360px;border-radius:var(--radius-md)}
  .grace-char__media{height:340px;border-radius:var(--radius-md) var(--radius-md) 0 0}
  .grace-prod__media{display:block;height:300px;background:var(--mist);position:relative;overflow:hidden}
  .grace-prod__media img{width:100%;height:100%;object-fit:contain;padding:14px}
  .grace-detail-card{background:var(--white);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:28px}
  .grace-detail-card h3{font-family:var(--font-display);font-size:24px;font-weight:600;color:var(--text-heading);margin:0 0 10px}
  .grace-detail-card p{font-size:14px;line-height:1.65;color:var(--text-muted);margin:0}
  .grace-cust{margin-top:14px;border-top:1px solid var(--border-subtle);padding-top:12px}
  .grace-cust summary{cursor:pointer;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);list-style:none}
  .grace-cust summary::-webkit-details-marker{display:none}
  .grace-cust ul{margin:12px 0 2px;padding:0;list-style:none;display:flex;flex-direction:column;gap:7px}
  .grace-cust li{font-size:13px;color:var(--text-muted)}
  .grace-cust li b{color:var(--text-heading)}
</style>

{%- capture grace_cust -%}<details class="grace-cust"><summary>What can be customized?</summary><ul><li><b>Face</b> — choose from our character options</li><li><b>Skin tone</b> — any colour you want</li><li><b>Finish</b> — matte, glossy or full fabric wrap</li><li><b>Base</b> — glass or metal</li><li><b>Arms</b> — optional in wood</li></ul></details>{%- endcapture -%}

<section class="amoy-block" style="padding-top:56px;padding-bottom:64px">
  <div class="amoy-container">
    <div class="amoy-grid--split" style="align-items:center">
      <div>
        <div class="amoy-eyebrow amoy-eyebrow--brass">{{ section.settings.eyebrow }}</div>
        <h1 class="amoy-display amoy-display--xl" style="margin:18px 0 0">{{ section.settings.heading }}</h1>
        <p style="font-size:17px;line-height:1.75;color:var(--text-body);margin:22px 0 0;max-width:48ch">{{ section.settings.intro }}</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:30px">
          <a href="{{ section.settings.whatsapp_url | default: 'https://wa.me/966547275228' }}" target="_blank" rel="noopener" class="amoy-btn amoy-btn--primary amoy-btn--lg">{{ section.settings.quote_label }}</a>
          <a href="/pages/contact" class="amoy-btn amoy-btn--secondary amoy-btn--lg">Contact us</a>
        </div>
      </div>
      <div class="grace-hero__media" style="min-height:460px;box-shadow:var(--shadow-sm)">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1200 | image_tag: style: 'width:100%;height:100%;object-fit:cover', loading: 'eager', alt: 'Grace Collection' }}
        {%- else -%}
          <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="52" height="52" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15l5-4 4 3 5-5 4 4"/></svg></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<section class="amoy-block" style="padding-top:0;padding-bottom:72px">
  <div class="amoy-container">
    <div class="amoy-grid--3">
      <div><div class="grace-feat__media">{%- if section.settings.f1_image != blank -%}{{ section.settings.f1_image | image_url: width: 700 | image_tag: style: 'width:100%;height:100%;object-fit:cover', alt: section.settings.f1_label }}{%- else -%}<div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>{%- endif -%}<span class="amoy-media-label">{{ section.settings.f1_label }}</span></div></div>
      <div><div class="grace-feat__media">{%- if section.settings.f2_image != blank -%}{{ section.settings.f2_image | image_url: width: 700 | image_tag: style: 'width:100%;height:100%;object-fit:cover', alt: section.settings.f2_label }}{%- else -%}<div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>{%- endif -%}<span class="amoy-media-label">{{ section.settings.f2_label }}</span></div></div>
      <div><div class="grace-feat__media">{%- if section.settings.f3_image != blank -%}{{ section.settings.f3_image | image_url: width: 700 | image_tag: style: 'width:100%;height:100%;object-fit:cover', alt: section.settings.f3_label }}{%- else -%}<div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>{%- endif -%}<span class="amoy-media-label">{{ section.settings.f3_label }}</span></div></div>
    </div>
  </div>
</section>

<section class="amoy-block" style="background:var(--mist)">
  <div class="amoy-container">
    <div class="amoy-eyebrow">Mannequin details</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 36px">Crafted to last</h2>
    <div class="amoy-grid--3">
      <div class="grace-detail-card"><h3>Materials</h3><p>Crafted from high-quality fiberglass — durable, lightweight and premium-finished for long-term use in retail environments.</p></div>
      <div class="grace-detail-card"><h3>Finish &amp; colour</h3><p>Default finish is semi-matte white for a clean, modern look. We can customise the colour and finish to match your brand or store concept.</p></div>
      <div class="grace-detail-card"><h3>Base type</h3><p>Tempered glass base with calf support for a clean, stable look. Custom base types available on request.</p></div>
    </div>
  </div>
</section>

<section class="amoy-block">
  <div class="amoy-container">
    <div class="amoy-eyebrow">Characters</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 36px">The faces of Grace</h2>
    <div class="amoy-grid--2">
      <div class="amoy-card"><div class="grace-char__media">{%- if section.settings.char1_image != blank -%}{{ section.settings.char1_image | image_url: width: 800 | image_tag: style: 'width:100%;height:100%;object-fit:cover', alt: section.settings.char1_name }}{%- else -%}<div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></div>{%- endif -%}</div><div class="amoy-card__body" style="padding:24px"><h3 style="font-family:var(--font-display);font-size:26px;font-weight:600;color:var(--text-heading);margin:0">{{ section.settings.char1_name }}</h3><p style="font-size:14px;color:var(--text-muted);margin:6px 0 0">{{ section.settings.char1_desc }}</p></div></div>
      <div class="amoy-card"><div class="grace-char__media">{%- if section.settings.char2_image != blank -%}{{ section.settings.char2_image | image_url: width: 800 | image_tag: style: 'width:100%;height:100%;object-fit:cover', alt: section.settings.char2_name }}{%- else -%}<div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-6 8-6s8 2 8 6"/></svg></div>{%- endif -%}</div><div class="amoy-card__body" style="padding:24px"><h3 style="font-family:var(--font-display);font-size:26px;font-weight:600;color:var(--text-heading);margin:0">{{ section.settings.char2_name }}</h3><p style="font-size:14px;color:var(--text-muted);margin:6px 0 0">{{ section.settings.char2_desc }}</p></div></div>
    </div>
  </div>
</section>

<section class="amoy-block" style="background:var(--mist)">
  <div class="amoy-container">
    <div class="amoy-eyebrow">The collection</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 8px">Full body &amp; forms</h2>
    <p style="font-size:15px;color:var(--text-muted);margin:0 0 34px;max-width:54ch">Every piece can be tailored to your store concept. Add products and photos to this collection to fill the grid.</p>
    <div class="amoy-grid--4">
      {%- if collection.products.size > 0 -%}
        {%- for product in collection.products -%}
          <div class="amoy-card">
            <a href="{{ product.url }}" class="grace-prod__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
              {%- else -%}
                <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
              {%- endif -%}
            </a>
            <div class="amoy-card__body">
              <h3 style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--text-heading);margin:0"><a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a></h3>
              <div style="font-size:15px;font-weight:700;margin-top:6px;font-variant-numeric:tabular-nums">{{ product.price | money }}</div>
              {{ grace_cust }}
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..8) -%}
          <div class="amoy-card">
            <div class="grace-prod__media"><div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div></div>
            <div class="amoy-card__body"><div style="height:18px;width:62%;background:var(--mist);border-radius:4px"></div>{{ grace_cust }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<section class="amoy-block" style="background:var(--navy-900)">
  <div class="amoy-container" style="max-width:760px;text-align:center">
    <div class="amoy-eyebrow amoy-eyebrow--brass" style="justify-content:center">Contact us</div>
    <h2 class="amoy-display amoy-display--lg" style="color:#fff;margin:18px 0 16px">Bring Grace to your store</h2>
    <p style="font-size:17px;line-height:1.65;color:var(--navy-200);max-width:46ch;margin:0 auto 30px">Tell us about your boutique and we'll share finishes, lead times and pricing across Saudi Arabia.</p>
    <div class="amoy-cta__btns">
      <a href="{{ section.settings.whatsapp_url | default: 'https://wa.me/966547275228' }}" target="_blank" rel="noopener" class="amoy-btn amoy-btn--inverse amoy-btn--lg">{{ section.settings.quote_label }}</a>
      <a href="mailto:support@amoylimited.com" class="amoy-btn amoy-btn--brass amoy-btn--lg">Email us</a>
    </div>
    <p style="font-size:13px;color:var(--navy-400);margin-top:26px">+966 54 727 5228 · support@amoylimited.com · Jeddah, Saudi Arabia</p>
  </div>
</section>
{% schema %}
{"name":"Grace Collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Grace Collection"},{"type":"text","id":"heading","label":"Heading","default":"Grace"},{"type":"textarea","id":"intro","label":"Intro paragraph","default":"The Grace Collection by AMOY is crafted to reflect elegance, softness and modern femininity. With smooth lines and poised silhouettes, each mannequin brings a refined presence to displays of loungewear and delicate fashion — made from high-quality fiberglass, perfect for women's fashion, lingerie and nightwear."},{"type":"url","id":"whatsapp_url","label":"Quote / WhatsApp URL"},{"type":"text","id":"quote_label","label":"Quote button label","default":"Request quotation"},{"type":"image_picker","id":"hero_image","label":"Hero image"},{"type":"header","content":"Featured poses"},{"type":"image_picker","id":"f1_image","label":"Feature 1 image"},{"type":"text","id":"f1_label","label":"Feature 1 label","default":"FA-05"},{"type":"image_picker","id":"f2_image","label":"Feature 2 image"},{"type":"text","id":"f2_label","label":"Feature 2 label","default":"FD-01"},{"type":"image_picker","id":"f3_image","label":"Feature 3 image"},{"type":"text","id":"f3_label","label":"Feature 3 label","default":"FA-09"},{"type":"header","content":"Characters"},{"type":"image_picker","id":"char1_image","label":"Character 1 image"},{"type":"text","id":"char1_name","label":"Character 1 name","default":"Nova"},{"type":"text","id":"char1_desc","label":"Character 1 description","default":"Confident stance, strong presence."},{"type":"image_picker","id":"char2_image","label":"Character 2 image"},{"type":"text","id":"char2_name","label":"Character 2 name","default":"Lira"},{"type":"text","id":"char2_desc","label":"Character 2 description","default":"Elegant lines, poised grace."}],"presets":[{"name":"Grace Collection"}]}
{% endschema %}