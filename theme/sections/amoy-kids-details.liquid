<style>
  .kids-detail-card{background:var(--white);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:28px}
  .kids-detail-card h3{font-family:var(--font-display);font-size:24px;font-weight:600;color:var(--text-heading);margin:0 0 10px}
  .kids-detail-card p{font-size:14px;line-height:1.65;color:var(--text-muted);margin:0}
</style>
<section class="amoy-block" style="background:var(--mist)">
  <div class="amoy-container">
    <div class="amoy-eyebrow">Mannequin details</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 36px">{{ section.settings.heading }}</h2>
    <div class="amoy-grid--3">
      <div class="kids-detail-card"><h3>{{ section.settings.card1_title }}</h3><p>{{ section.settings.card1_text }}</p></div>
      <div class="kids-detail-card"><h3>{{ section.settings.card2_title }}</h3><p>{{ section.settings.card2_text }}</p></div>
      <div class="kids-detail-card"><h3>{{ section.settings.card3_title }}</h3><p>{{ section.settings.card3_text }}</p></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Kids · Details","settings":[{"type":"text","id":"heading","label":"Section heading","default":"Built for children's retail"},{"type":"text","id":"card1_title","label":"Card 1 title","default":"Materials"},{"type":"textarea","id":"card1_text","label":"Card 1 text","default":"Lightweight, durable fiberglass with smooth edges — safe and built to last in busy retail environments."},{"type":"text","id":"card2_title","label":"Card 2 title","default":"Size range"},{"type":"textarea","id":"card2_text","label":"Card 2 text","default":"Available in toddler through teen sizes. Custom sizing available on request to match your specific garment range."},{"type":"text","id":"card3_title","label":"Card 3 title","default":"Finish options"},{"type":"textarea","id":"card3_text","label":"Card 3 text","default":"Semi-matte white as standard. Full customisation of colour, finish and skin tone available for any order."}],"presets":[{"name":"Kids · Details"}]}
{% endschema %}