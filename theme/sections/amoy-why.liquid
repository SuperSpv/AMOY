<section class="amoy-block">
  <div class="amoy-container">
    <div class="amoy-grid--split-media">
      <div class="amoy-why__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500,700,900,1200', sizes: '(min-width: 769px) 46vw, 100vw', style: 'width:100%;height:100%;object-fit:cover' }}
        {%- else -%}
          <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1" opacity=".2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9l3-3m0 0h3m-3 0v3"/></svg></div>
        {%- endif -%}
        <span class="amoy-media-label">{{ section.settings.image_caption }}</span>
      </div>
      <div>
        <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="amoy-display amoy-display--lg" style="margin:18px 0 22px">{{ section.settings.heading }}</h2>
        <p style="font-size:17px;line-height:1.7;color:var(--text-muted);max-width:52ch;margin:0 0 36px">{{ section.settings.body }}</p>
        <div class="amoy-why__feats">
          {%- for block in section.blocks -%}
            <div class="amoy-feat" {{ block.shopify_attributes }}>
              <span class="amoy-feat__icon">
                {%- case forloop.index -%}
                  {%- when 1 -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3l-1.5 6L12 21M15 3l1.5 6L12 21"/></svg>
                  {%- when 2 -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11Z"/></svg>
                  {%- when 3 -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="6" r="2.5"/><path d="M12 8.5V16M7 21h10M9 21l3-5 3 5"/></svg>
                  {%- when 4 -%}<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-5.5-7-11a7 7 0 0 1 14 0c0 5.5-7 11-7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                {%- endcase -%}
              </span>
              <div>
                <h3 class="amoy-feat__title">{{ block.settings.title }}</h3>
                <p class="amoy-feat__body">{{ block.settings.body }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Why AMOY","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Why AMOY"},{"type":"textarea","id":"heading","label":"Heading","default":"Built by hand, finished like furniture."},{"type":"textarea","id":"body","label":"Body","default":"Every AMOY mannequin starts as fiberglass and ends as a considered object — sanded, sealed and finished to a calm semi-matte white. The kind of quality your windows can stand next to."},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"image_caption","label":"Image caption","default":"workshop · hand-finishing the semi-matte surface"}],"blocks":[{"type":"feature","name":"Feature","settings":[{"type":"text","id":"title","label":"Title","default":"Hand-finished fiberglass"},{"type":"textarea","id":"body","label":"Body","default":"Durable, lightweight forms with a flawless, gallery-grade surface."}]}],"max_blocks":4,"presets":[{"name":"Why AMOY","blocks":[{"type":"feature","settings":{"title":"Hand-finished fiberglass","body":"Durable, lightweight forms with a flawless, gallery-grade surface."}},{"type":"feature","settings":{"title":"Any finish you specify","body":"Semi-matte white by default — or any colour and sheen to match your concept."}},{"type":"feature","settings":{"title":"Tempered-glass bases","body":"Stable, near-invisible support with calf fittings that keep poses clean."}},{"type":"feature","settings":{"title":"Made in Saudi Arabia","body":"Manufactured in Jeddah and delivered across the Kingdom, lead times short."}}]}]}
{% endschema %}