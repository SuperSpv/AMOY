{{ 'amoy-blog.css' | asset_url | stylesheet_tag }}
{%- assign featured_article = blog.articles.first -%}
<section class="blog-hero"><div class="blog-hero-inner"><div class="eyebrow">{{ section.settings.eyebrow | default: 'AMOY Insights' }}</div><h1 class="blog-hero-title">{{ section.settings.hero_title | default: 'Ideas for the discerning visual merchandiser.' }}</h1>{%- if section.settings.hero_subtitle != blank -%}<p class="blog-hero-sub">{{ section.settings.hero_subtitle }}</p>{%- endif -%}</div></section>
{%- if featured_article and section.settings.show_featured -%}
<section class="featured-section"><div class="featured-section-inner"><div class="featured-label">Featured</div><a href="{{ featured_article.url }}" class="featured-card">{%- if featured_article.image -%}<div class="featured-img"><img src="{{ featured_article.image | image_url: width: 900 }}" alt="{{ featured_article.image.alt | default: featured_article.title | escape }}" width="900" height="675" loading="eager"></div>{%- else -%}<div class="featured-img"><div class="img-placeholder"></div></div>{%- endif -%}<div class="featured-content">{%- if featured_article.tags.size > 0 -%}<span class="post-category">{{ featured_article.tags.first }}</span>{%- endif -%}<h2 class="featured-title">{{ featured_article.title }}</h2><p class="featured-excerpt">{{ featured_article.excerpt_or_content | strip_html | truncate: 200 }}</p><div class="post-meta"><span>{{ featured_article.published_at | date: '%B %d, %Y' }}</span><span class="post-meta-sep"></span>{%- assign words = featured_article.content | strip_html | number_of_words -%}{%- assign read_time = words | divided_by: 200 | plus: 1 -%}<span>{{ read_time }} min read</span></div><span class="read-more">Read article &rarr;</span></div></a></div></section>
{%- endif -%}
<section class="posts-section"><div class="posts-section-inner"><div class="section-divider"></div>{%- paginate blog.articles by section.settings.posts_per_page -%}<div class="posts-grid">{%- for article in blog.articles -%}{%- unless section.settings.show_featured and paginate.current_page == 1 and article.id == featured_article.id -%}{%- render 'blog-card', article: article -%}{%- endunless -%}{%- endfor -%}</div>{%- if paginate.pages > 1 -%}<div class="pagination">{%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="pagination-btn">&larr; Previous</a>{%- endif -%}<span class="pagination-count">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="pagination-btn">Next &rarr;</a>{%- endif -%}</div>{%- endif -%}{%- endpaginate -%}</div></section>
{%- if section.settings.show_cta -%}<section class="cta-strip"><div class="cta-strip-inner"><div><h3 class="cta-strip-title">{{ section.settings.cta_title | default: "Ready to elevate your brand's presence?" }}</h3><p class="cta-strip-sub">{{ section.settings.cta_subtitle | default: 'Request a catalog or book a consultation with our team in Jeddah.' }}</p></div><div class="cta-strip-actions">{%- if section.settings.cta_phone != blank -%}<a href="tel:{{ section.settings.cta_phone | remove: ' ' | remove: '-' }}" class="btn-outline-light">{{ section.settings.cta_phone }}</a>{%- endif -%}<a href="{{ section.settings.cta_button_url }}" class="btn-brass">{{ section.settings.cta_button_label | default: 'Request a catalog' }} &rarr;</a></div></div></section>{%- endif -%}
{% schema %}{"name":"Blog Posts","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow label","default":"AMOY Insights"},{"type":"text","id":"hero_title","label":"Hero heading","default":"Ideas for the discerning visual merchandiser."},{"type":"text","id":"hero_subtitle","label":"Hero subtitle","default":"Craft, innovation and retail intelligence — from the studio floor in Jeddah."},{"type":"checkbox","id":"show_featured","label":"Show featured post","default":true},{"type":"range","id":"posts_per_page","min":3,"max":12,"step":3,"label":"Posts per page","default":9},{"type":"header","content":"CTA Strip"},{"type":"checkbox","id":"show_cta","label":"Show CTA strip","default":true},{"type":"text","id":"cta_title","label":"CTA heading","default":"Ready to elevate your brand's presence?"},{"type":"text","id":"cta_subtitle","label":"CTA subtext","default":"Request a catalog or book a consultation with our team in Jeddah."},{"type":"text","id":"cta_phone","label":"CTA phone","default":"+966 54 727 5228"},{"type":"url","id":"cta_button_url","label":"CTA button URL"},{"type":"text","id":"cta_button_label","label":"CTA button label","default":"Request a catalog"}]}{% endschema %}
