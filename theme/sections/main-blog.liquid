{{ 'amoy-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign featured_article = blog.articles.first
  assign show_featured = section.settings.show_featured
-%}

<section class="blog-hero">
  <div class="blog-hero-inner">
    <div class="eyebrow">{% if section.settings.eyebrow != blank %}{{ section.settings.eyebrow }}{% else %}{{ 'blog.insights' | t }}{% endif %}</div>
    <h1 class="blog-hero-title">{{ section.settings.hero_title | default: blog.title }}</h1>
    <p class="blog-hero-sub">{% if section.settings.hero_subtitle != blank %}{{ section.settings.hero_subtitle }}{% else %}{{ 'blog.subtitle' | t }}{% endif %}</p>
    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <div class="blog-tags">
        <a href="{{ blog.url }}" class="tag-chip{% unless current_tags %} is-active{% endunless %}">{{ 'general.all' | t }}</a>
        {%- for tag in blog.all_tags -%}
          <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="tag-chip{% if current_tags contains tag %} is-active{% endif %}">{{ tag }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if blog.articles_count == 0 -%}
  <section class="posts-section">
    <div class="posts-section-inner">
      <p style="color:var(--text-muted);text-align:center;padding:48px 0">{{ 'blog.no_posts' | t }}</p>
    </div>
  </section>
{%- else -%}
  {%- if featured_article and show_featured and current_page == 1 and current_tags == blank -%}
    <section class="featured-section">
      <div class="featured-section-inner">
        <div class="featured-label">{{ 'blog.featured' | t }}</div>
        <a href="{{ featured_article.url }}" class="featured-card">
          <div class="featured-img">
            {%- if featured_article.image -%}
              {{ featured_article.image | image_url: width: 1200 | image_tag: widths: '450,700,900,1200', sizes: '(min-width: 990px) 55vw, 100vw', loading: 'eager', alt: featured_article.image.alt | default: featured_article.title }}
            {%- else -%}
              <div class="img-placeholder"></div>
            {%- endif -%}
          </div>
          {%- capture featured_lang -%}{% render 'amoy-lang-attrs', text: featured_article.title %}{%- endcapture -%}
          <div class="featured-content">
            {%- if featured_article.tags.size > 0 -%}
              <span class="post-category">{{ featured_article.tags.first }}</span>
            {%- endif -%}
            <h2 class="featured-title"{{ featured_lang }}>{{ featured_article.title }}</h2>
            <p class="featured-excerpt"{{ featured_lang }}>{{ featured_article.excerpt_or_content | strip_html | truncate: 200 }}</p>
            <div class="post-meta">
              <time datetime="{{ featured_article.published_at | date: '%Y-%m-%d' }}">{{ featured_article.published_at | date: format: 'date' }}</time>
              <span class="post-meta-sep"></span>
              {%- assign fwords = featured_article.content | strip_html | split: ' ' | size -%}
              {%- assign fread = fwords | divided_by: 200 | plus: 1 -%}
              <span>{{ 'blog.min_read' | t: count: fread }}</span>
            </div>
            <span class="read-more">{{ 'blog.read_article' | t }} {% render 'amoy-arrow' %}</span>
          </div>
        </a>
      </div>
    </section>
  {%- endif -%}

  <section class="posts-section">
    <div class="posts-section-inner">
      <div class="section-divider"></div>
      {%- paginate blog.articles by section.settings.posts_per_page -%}
        <div class="posts-grid">
          {%- for article in blog.articles -%}
            {%- if show_featured and paginate.current_page == 1 and current_tags == blank and article.id == featured_article.id -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign card_lazy = true
              if forloop.index <= 3
                assign card_lazy = false
              endif
            -%}
            {%- render 'blog-card', article: article, lazy: card_lazy -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination" role="navigation" aria-label="{{ 'general.pagination' | t }}">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="pagination-btn">{% render 'amoy-arrow', direction: 'back' %} {{ 'general.previous' | t }}</a>
            {%- endif -%}
            <span class="pagination-count">{{ 'blog.page_of' | t: current: paginate.current_page, total: paginate.pages }}</span>
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="pagination-btn">{{ 'general.next' | t }} {% render 'amoy-arrow' %}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>
{%- endif -%}

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'cta' -%}
      <section class="cta-strip" {{ block.shopify_attributes }}>
        <div class="cta-strip-inner">
          <div>
            <h2 class="cta-strip-title">{{ block.settings.title }}</h2>
            <p class="cta-strip-sub">{{ block.settings.subtitle }}</p>
          </div>
          <div class="cta-strip-actions">
            {%- if block.settings.show_phone and settings.contact_phone != blank -%}
              <a href="tel:{{ settings.contact_phone | remove: ' ' | remove: '-' }}" class="btn-outline-light amoy-ltr">{{ settings.contact_phone }}</a>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              {%- capture cta_url -%}{% render 'amoy-url', url: block.settings.button_url, fallback: '/pages/contact' %}{%- endcapture -%}
              <a href="{{ cta_url }}" class="btn-brass">{{ block.settings.button_label }} {% render 'amoy-arrow' %}</a>
            {%- endif -%}
          </div>
        </div>
      </section>
    {%- when '@app' -%}
      <div {{ block.shopify_attributes }}>{% render block %}</div>
  {%- endcase -%}
{%- endfor -%}

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "info": "Leave blank for the translated \"AMOY Insights\"." },
    { "type": "text", "id": "hero_title", "label": "Heading", "info": "Leave blank to use the blog title." },
    { "type": "text", "id": "hero_subtitle", "label": "Subtitle", "info": "Leave blank for the translated default subtitle." },
    { "type": "checkbox", "id": "show_tags", "label": "Show tag filters", "default": true },
    { "type": "checkbox", "id": "show_featured", "label": "Highlight the newest post", "default": true },
    { "type": "range", "id": "posts_per_page", "min": 3, "max": 24, "step": 3, "label": "Posts per page", "default": 9 }
  ],
  "blocks": [
    {
      "type": "cta",
      "name": "Call to action strip",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Ready to elevate your brand's presence?" },
        { "type": "text", "id": "subtitle", "label": "Subtext", "default": "Request a catalog or book a consultation with our team in Jeddah." },
        { "type": "checkbox", "id": "show_phone", "label": "Show phone number", "default": true, "info": "Comes from Theme settings → Contact & social." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Request a catalog" },
        { "type": "url", "id": "button_url", "label": "Button link" }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [{ "name": "Blog posts", "blocks": [{ "type": "cta" }] }]
}
{% endschema %}
