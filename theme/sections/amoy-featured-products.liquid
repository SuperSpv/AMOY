{{ 'section-featured-products.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign col = section.settings.collection
  assign use_blocks = false
  if section.settings.source == 'blocks' and section.blocks.size > 0
    assign use_blocks = true
  endif
  assign view_all_url = routes.all_products_collection_url
  if col != blank
    assign view_all_url = col.url
  endif
-%}

<section class="amoy-block">
  <div class="amoy-container">
    <div class="amoy-fp-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="amoy-display amoy-display--md amoy-fp-title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      <a href="{{ view_all_url }}" class="amoy-fp-viewall">
        {{ 'general.shop_all' | t }}
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
      </a>
    </div>

    <div class="amoy-fp-wrap" data-carousel>
      <button class="amoy-fp-arrow amoy-fp-arrow--prev" data-carousel-prev aria-label="{{ 'general.previous' | t }}" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
      </button>

      <div class="amoy-fp-scroll" data-carousel-track>
        <div class="amoy-fp-inner">
          {%- if use_blocks -%}
            {%- for block in section.blocks -%}
              {%- assign p = block.settings.product -%}
              {%- if p != blank -%}
                <div class="amoy-fp-card" {{ block.shopify_attributes }}>
                  {% render 'product-card', card_product: p %}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- elsif col != blank -%}
            {%- for product in col.products limit: section.settings.product_limit -%}
              <div class="amoy-fp-card">
                {% render 'product-card', card_product: product %}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              <div class="amoy-fp-card">{% render 'product-card' %}</div>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>

      <button class="amoy-fp-arrow amoy-fp-arrow--next" data-carousel-next aria-label="{{ 'general.next' | t }}" type="button">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured pieces" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ready to ship" },
    {
      "type": "select",
      "id": "source",
      "label": "Products shown",
      "options": [
        { "value": "collection", "label": "From a collection" },
        { "value": "blocks", "label": "Hand-picked" }
      ],
      "default": "collection"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "product_limit", "min": 4, "max": 16, "step": 2, "label": "Maximum products", "default": 8 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
