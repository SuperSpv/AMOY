<style>
  .kids-part__media{display:block;height:260px;background:var(--mist);position:relative;overflow:hidden}
  .kids-part__media img{width:100%;height:100%;object-fit:contain;padding:12px}
  .kids-part__row{display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px;flex-wrap:wrap}
</style>
{%- assign src_collection = collections[section.settings.collection_handle] | default: collection -%}
<section class="amoy-block">
  <div class="amoy-container">
    <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 8px">{{ section.settings.heading }}</h2>
    <p style="font-size:15px;color:var(--text-muted);margin:0 0 34px;max-width:54ch">{{ section.settings.subtext }}</p>
    <div class="amoy-grid--4">
      {%- assign shown = 0 -%}
      {%- comment -%} Forms only, ordered: torso/bust (tier 1) → other parts like hand/foot/leg (tier 2) {%- endcomment -%}
      {%- for tier in (1..2) -%}
      {%- for product in src_collection.products -%}
        {%- comment -%} Skip full-body mannequins — matched by tag/handle because product types are translated on /ar {%- endcomment -%}
        {%- if product.tags contains 'full body mannequin' or product.handle contains 'full-body' -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign ptier = 2
          if product.handle contains 'torso' or product.handle contains 'bust' or product.handle contains 'hip'
            assign ptier = 1
          endif
        -%}
        {%- if ptier != tier -%}{%- continue -%}{%- endif -%}
        {%- if section.settings.filter_tag == blank or product.tags contains section.settings.filter_tag -%}
          <div class="amoy-card">
            <a href="{{ product.url }}" class="kids-part__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
              {%- else -%}
                <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
              {%- endif -%}
            </a>
            <div class="amoy-card__body">
              <div style="font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--steel)">{{ product.type }}</div>
              <h3 style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--text-heading);margin:2px 0 0"><a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a></h3>
              <div class="kids-part__row">
                {% render 'price', product: product %}
                {% render 'quick-add-button', product: product %}
              </div>
            </div>
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        {%- for i in (1..4) -%}
          <div class="amoy-card">
            <div class="kids-part__media"><div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><path d="M12 2a4 4 0 0 1 4 4M8 6a4 4 0 0 1 4-4M6 12h12M9 20l3-8 3 8"/></svg></div></div>
            <div class="amoy-card__body"><div style="height:12px;width:40%;background:var(--border-default);border-radius:4px;margin-bottom:6px"></div><div style="height:18px;width:70%;background:var(--border-default);border-radius:4px"></div></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Kids · Body Parts","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Body parts & forms"},{"type":"text","id":"heading","label":"Heading","default":"Display forms & parts"},{"type":"textarea","id":"subtext","label":"Subtext","default":"Torsos, busts, arms and leg forms — ideal for focused displays of accessories, footwear and childrenswear."},{"type":"text","id":"collection_handle","label":"Collection handle (optional)","info":"Leave blank to use the current collection. Enter a handle like 'kids-body-parts' to pull from a specific sub-collection."},{"type":"text","id":"filter_tag","label":"Filter by tag (optional)","info":"Enter a product tag like 'body-parts' to show only matching products."}],"presets":[{"name":"Kids · Body Parts"}]}
{% endschema %}
