<style>
  .kids-prod__media{display:block;height:300px;background:var(--mist);position:relative;overflow:hidden}
  .kids-prod__media img{width:100%;height:100%;object-fit:contain;padding:14px}
  .kids-cust{margin-top:14px;border-top:1px solid var(--border-subtle);padding-top:12px}
  .kids-cust summary{cursor:pointer;font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);list-style:none}
  .kids-cust summary::-webkit-details-marker{display:none}
  .kids-cust ul{margin:12px 0 2px;padding:0;list-style:none;display:flex;flex-direction:column;gap:7px}
  .kids-cust li{font-size:13px;color:var(--text-muted)}
  .kids-cust li b{color:var(--text-heading)}
  .kids-prod__row{display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:8px;flex-wrap:wrap}
</style>
{%- capture kids_cust -%}
<details class="kids-cust">
  <summary>What can be customized?</summary>
  <ul>
    <li><b>Skin tone</b> — any colour you want</li>
    <li><b>Finish</b> — matte, glossy or fabric wrap</li>
    <li><b>Size</b> — toddler to teen on request</li>
    <li><b>Base</b> — glass or metal</li>
  </ul>
</details>
{%- endcapture -%}
{%- assign src_collection = collections[section.settings.collection_handle] | default: collection -%}
<section class="amoy-block" style="background:var(--mist)">
  <div class="amoy-container">
    <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 8px">{{ section.settings.heading }}</h2>
    <p style="font-size:15px;color:var(--text-muted);margin:0 0 34px;max-width:54ch">{{ section.settings.subtext }}</p>
    <div class="amoy-grid--4">
      {%- assign shown = 0 -%}
      {%- comment -%} Full-body mannequins only {%- endcomment -%}
      {%- for product in src_collection.products -%}
        {%- unless product.type contains 'Mannequin' -%}{%- continue -%}{%- endunless -%}
        {%- if section.settings.filter_tag == blank or product.tags contains section.settings.filter_tag -%}
          <div class="amoy-card">
            <a href="{{ product.url }}" class="kids-prod__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: product.title }}
              {%- else -%}
                <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
              {%- endif -%}
            </a>
            <div class="amoy-card__body">
              <h3 style="font-family:var(--font-display);font-size:20px;font-weight:600;color:var(--text-heading);margin:0"><a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a></h3>
              <div class="kids-prod__row">
                <span style="font-size:15px;font-weight:700;font-variant-numeric:tabular-nums">{{ product.price | money }}</span>
                <button class="amoy-btn amoy-btn--secondary" style="padding:6px 12px;font-size:12.5px;border-radius:var(--radius-sm)" data-add-to-cart data-variant-id="{{ product.selected_or_first_available_variant.id | default: product.variants.first.id }}">+ Add</button>
              </div>
              {{ kids_cust }}
            </div>
          </div>
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if shown == 0 -%}
        {%- for i in (1..4) -%}
          <div class="amoy-card">
            <div class="kids-prod__media"><div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1" opacity=".18"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div></div>
            <div class="amoy-card__body"><div style="height:18px;width:62%;background:var(--border-default);border-radius:4px;margin-bottom:8px"></div>{{ kids_cust }}</div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"Kids · Full Body","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Full body mannequins"},{"type":"text","id":"heading","label":"Heading","default":"Complete forms"},{"type":"textarea","id":"subtext","label":"Subtext","default":"Full standing and posed mannequins for children's apparel displays. Each form is fully customisable."},{"type":"text","id":"collection_handle","label":"Collection handle (optional)","info":"Leave blank to use the current collection. Enter a handle like 'kids-full-body' to pull from a specific sub-collection."},{"type":"text","id":"filter_tag","label":"Filter by tag (optional)","info":"Enter a product tag like 'full-body' to show only matching products from the collection."}],"presets":[{"name":"Kids · Full Body"}]}
{% endschema %}
