<style>
  .grace-detail-card{background:var(--white);border:1px solid var(--border-default);border-radius:var(--radius-md);padding:28px}
  .grace-detail-card h3{font-family:var(--font-display);font-size:24px;font-weight:600;color:var(--text-heading);margin:0 0 10px}
  .grace-detail-card p{font-size:14px;line-height:1.65;color:var(--text-muted);margin:0}
</style>
<section class="amoy-block" style="background:var(--mist)">
  <div class="amoy-container">
    <div class="amoy-eyebrow">{{ 'collection_page.details_eyebrow' | t }}</div>
    <h2 class="amoy-display amoy-display--md" style="margin:14px 0 36px">{{ section.settings.heading }}</h2>
    <div class="amoy-grid--3">
      <div class="grace-detail-card"><h3>{{ section.settings.card1_title }}</h3><p>{{ section.settings.card1_text }}</p></div>
      <div class="grace-detail-card"><h3>{{ section.settings.card2_title }}</h3><p>{{ section.settings.card2_text }}</p></div>
      <div class="grace-detail-card"><h3>{{ section.settings.card3_title }}</h3><p>{{ section.settings.card3_text }}</p></div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Grace · Details","settings":[{"type":"text","id":"heading","label":"Section heading","default":"Crafted to last"},{"type":"text","id":"card1_title","label":"Card 1 title","default":"Materials"},{"type":"textarea","id":"card1_text","label":"Card 1 text","default":"Crafted from high-quality fiberglass — durable, lightweight and premium-finished for long-term use in retail environments."},{"type":"text","id":"card2_title","label":"Card 2 title","default":"Finish & colour"},{"type":"textarea","id":"card2_text","label":"Card 2 text","default":"Default finish is semi-matte white for a clean, modern look. Customise colour and finish to match your brand."},{"type":"text","id":"card3_title","label":"Card 3 title","default":"Base type"},{"type":"textarea","id":"card3_text","label":"Card 3 text","default":"Tempered glass base with calf support for a clean, stable look. Custom base types available on request."}],"presets":[{"name":"Grace · Details"}]}
{% endschema %}