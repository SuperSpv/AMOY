<style>
  .amoy-collection-card .amoy-card__media{position:relative}
  .amoy-collection-cta{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);white-space:nowrap;background:rgba(255,255,255,.92);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.6);color:#1C1B4D;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:8px 18px;border-radius:999px;opacity:0;transition:opacity .22s,transform .22s;transform:translateX(-50%) translateY(6px);pointer-events:none}
  .amoy-collection-card:hover .amoy-collection-cta,.amoy-collection-card:focus-within .amoy-collection-cta{opacity:1;transform:translateX(-50%) translateY(0)}
  .amoy-collection-arrow{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.3);flex:none;transition:background .18s}
  .amoy-collection-card:hover .amoy-collection-arrow{background:rgba(255,255,255,.28)}
  @media(max-width:768px){
    .amoy-collection-card .amoy-card__media{height:220px !important}
    .amoy-collection-cta{opacity:1 !important;transform:translateX(-50%) translateY(0) !important;pointer-events:auto}
    .amoy-collection-card .amoy-card__body{border-top:3px solid #B08A22}
    .amoy-collection-shop-row{display:flex !important}
  }
</style>
<section class="amoy-block" style="background:var(--white);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)">
  <div class="amoy-container">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:40px;flex-wrap:wrap;gap:16px">
      <div>
        <div class="amoy-eyebrow">{{ section.settings.eyebrow }}</div>
        <h2 class="amoy-display amoy-display--lg" style="margin:16px 0 0">{{ section.settings.heading }}</h2>
      </div>
      <a href="/collections/all" style="font-size:14px;font-weight:600;color:var(--accent);display:inline-flex;align-items:center;gap:7px">View all <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </div>
    <div class="amoy-grid--3">
      {%- for block in section.blocks -%}
        {%- assign card_bg = block.settings.bg_color | default: '' -%}
        <a href="{{ block.settings.url }}" class="amoy-card amoy-card--interactive amoy-collection-card" {{ block.shopify_attributes }}{% if card_bg != '' and card_bg != '#ffffff' and card_bg != '#FFFFFF' %} style="background:{{ card_bg }}"{% endif %}>
          <div class="amoy-card__media" style="height:320px">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: style: 'width:100%;height:100%;object-fit:cover' }}
            {%- else -%}
              <div class="amoy-placeholder"><svg viewBox="0 0 24 24" width="48" height="48" fill="none" stroke="currentColor" stroke-width="1" opacity=".2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
            {%- endif -%}
            <span class="amoy-media-label">{{ block.settings.caption }}</span>
            <span class="amoy-collection-cta">Shop Collection &rarr;</span>
          </div>
          <div class="amoy-card__body">
            <div style="display:flex;justify-content:space-between;align-items:center">
              <span class="amoy-eyebrow" style="margin-bottom:0">{{ block.settings.tag }}</span>
              <span class="amoy-collection-arrow">
                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="var(--slate)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8"/></svg>
              </span>
            </div>
            <h3 style="font-family:var(--font-display);font-weight:600;font-size:28px;line-height:1.05;color:var(--text-heading);margin:4px 0 6px">{{ block.settings.name }}</h3>
            <p style="font-size:13.5px;color:var(--text-muted);line-height:1.5">{{ block.settings.desc }}</p>
            <div class="amoy-collection-shop-row" style="display:none;align-items:center;gap:6px;margin-top:10px;font-size:12.5px;font-weight:700;color:#B08A22;letter-spacing:.04em">Shop Collection <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"AMOY Collections","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Collections"},{"type":"text","id":"heading","label":"Heading","default":"A character for every brand"}],"blocks":[{"type":"collection_card","name":"Collection card","settings":[{"type":"text","id":"name","label":"Name","default":"Grace"},{"type":"text","id":"tag","label":"Tag","default":"Female"},{"type":"text","id":"desc","label":"Description","default":"Lingerie, nightwear & luxury fashion."},{"type":"text","id":"caption","label":"Caption","default":"Grace collection"},{"type":"url","id":"url","label":"Link"},{"type":"image_picker","id":"image","label":"Image"},{"type":"color","id":"bg_color","label":"Card Background Color","default":"#FFFFFF"}]}],"presets":[{"name":"AMOY Collections","blocks":[{"type":"collection_card","settings":{"name":"Grace","tag":"Female","desc":"Lingerie, nightwear & luxury fashion."}},{"type":"collection_card","settings":{"name":"Kids","tag":"Child","desc":"Playful forms for babywear & junior."}},{"type":"collection_card","settings":{"name":"Sport","tag":"Active","desc":"Dynamic poses for sportswear."}}]}]}
{% endschema %}