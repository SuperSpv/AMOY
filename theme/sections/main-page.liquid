{% style %}
  .amoy-page{max-width:820px;margin:0 auto;padding:64px 40px 90px}
  .amoy-page__body{font-size:16px;line-height:1.8;color:var(--text-body)}
  .amoy-page__body h2{font-family:var(--font-display);font-weight:600;font-size:30px;color:var(--text-heading);margin:38px 0 14px;letter-spacing:-.01em}
  .amoy-page__body h3{font-family:var(--font-display);font-weight:600;font-size:23px;color:var(--text-heading);margin:30px 0 12px}
  .amoy-page__body p{margin:0 0 18px}
  .amoy-page__body a{color:var(--accent);font-weight:600}
  .amoy-page__body ul,.amoy-page__body ol{margin:0 0 18px;padding-left:22px}
  .amoy-page__body li{margin:0 0 8px}
  .amoy-page__body img{max-width:100%;height:auto;border-radius:var(--radius-md)}
  [dir=rtl] .amoy-page__body ul,[dir=rtl] .amoy-page__body ol{padding-left:0;padding-right:22px}
  @media (max-width:768px){.amoy-page{padding:40px 20px 64px}.amoy-page__body h2{font-size:25px}}
{% endstyle %}
<div class="amoy-page">
  <div class="amoy-eyebrow">{{ shop.name }}</div>
  <h1 class="amoy-display amoy-display--lg" style="margin:14px 0 26px">{{ page.title }}</h1>
  <div class="amoy-page__body rte">{{ page.content }}</div>
</div>
{% schema %}
{"name":"Page","settings":[],"presets":[{"name":"Page"}]}
{% endschema %}
