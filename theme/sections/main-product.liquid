{{ 'section-product.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign is_quick = false
  if template.suffix == 'quick-add'
    assign is_quick = true
  endif
-%}

<div class="amoy-pdp amoy-container" data-product-root>
  {%- unless is_quick -%}
    <nav class="amoy-pdp__breadcrumb" aria-label="Breadcrumb">
      <a href="{% if collection %}{{ collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">
        {% render 'icon', icon: 'arrow-left', size: 17 %}
        {%- if collection -%}{{ collection.title }}{%- else -%}{{ 'general.back_to_shop' | t }}{%- endif -%}
      </a>
    </nav>
  {%- endunless -%}

  <div class="amoy-pdp__grid">
    <div class="amoy-pdp__gallery" data-gallery>
      {%- if product.media.size > 1 -%}
        <div class="amoy-pdp__thumbs" role="group" aria-label="{{ product.title }}">
          {%- for media in product.media -%}
            <button
              type="button"
              class="amoy-pdp__thumb{% if forloop.first %} is-active{% endif %}"
              data-thumb
              data-media-id="{{ media.id }}"
              aria-label="{{ 'accessibility.view_image' | t: index: forloop.index }}"
            >
              {{ media.preview_image | image_url: width: 160 | image_tag: width: 74, height: 96, loading: 'lazy', alt: media.alt | default: product.title }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="amoy-pdp__stage">
        {%- if product.media.size > 0 -%}
          {%- for media in product.media -%}
            <div class="amoy-pdp__media{% if forloop.first %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign media_loading = 'lazy'
                    if forloop.first
                      assign media_loading = 'eager'
                    endif
                  -%}
                  {{
                    media
                    | image_url: width: 1200
                    | image_tag:
                      widths: '400,600,800,1000,1200',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      loading: media_loading,
                      alt: media.alt | default: product.title
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, image_size: '1200x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag }}
                {%- when 'model' -%}
                  {{ media | model_viewer_tag: image_size: '1200x' }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="amoy-pdp__media is-active">
            <div class="amoy-placeholder">{% render 'icon', icon: 'placeholder', size: 64 %}</div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="amoy-pdp__info">
      {%- form 'product', product, class: 'amoy-product-form', novalidate: 'novalidate', data-product-form: '' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'type' -%}
              {%- if product.type != blank -%}
                <div class="amoy-eyebrow" {{ block.shopify_attributes }}>{{ product.type }}</div>
              {%- endif -%}

            {%- when 'title' -%}
              <h1 class="amoy-pdp__title" {{ block.shopify_attributes }}>{{ product.title }}</h1>

            {%- when 'price' -%}
              <div class="amoy-pdp__price-row" data-price-block {{ block.shopify_attributes }}>
                {% render 'price', product: product, variant: current_variant, size: 'lg' %}
                {%- if current_variant.compare_at_price > current_variant.price -%}
                  <span class="amoy-pdp__save">{{ 'products.save' | t }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.price_note != blank -%}
                <div class="amoy-pdp__price-note">{{ block.settings.price_note }}</div>
              {%- endif -%}
              {%- if block.settings.show_taxes_note -%}
                <div class="amoy-pdp__price-note">{{ 'cart.taxes_and_shipping' | t }}</div>
              {%- endif -%}

            {%- when 'inventory' -%}
              {%- if current_variant.available -%}
                {%- if current_variant.inventory_management != blank and current_variant.inventory_quantity <= block.settings.low_stock_threshold and current_variant.inventory_quantity > 0 -%}
                  <div class="amoy-pdp__stock amoy-pdp__stock--low" {{ block.shopify_attributes }}>{{ 'products.low_stock' | t }} ({{ current_variant.inventory_quantity }})</div>
                {%- else -%}
                  <div class="amoy-pdp__stock" {{ block.shopify_attributes }}>{{ 'products.in_stock' | t }}</div>
                {%- endif -%}
              {%- endif -%}

            {%- when 'description' -%}
              <div class="amoy-pdp__description rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="amoy-variants" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="amoy-variant-group">
                      <legend class="amoy-variant-group__label">
                        {{ option.name }}
                        <span data-option-value="{{ forloop.index }}">{{ option.selected_value }}</span>
                      </legend>
                      <div class="amoy-variant-group__opts">
                        {%- for value in option.values -%}
                          <label class="amoy-variant-opt">
                            <input type="radio" name="option{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                            <span>{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </div>
                <script type="application/json" data-variant-data>
                  {{ product.variants | json }}
                </script>
              {%- endunless -%}

            {%- when 'quantity' -%}
              <div class="amoy-pdp__qty-block" {{ block.shopify_attributes }}>
                <label class="amoy-label" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
                <div class="amoy-qty" data-qty-wrap>
                  <button type="button" class="amoy-qty__btn" data-qty-step="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}">{% render 'icon', icon: 'minus', size: 16 %}</button>
                  <input
                    class="amoy-qty__val"
                    id="Quantity-{{ section.id }}"
                    type="number"
                    name="quantity"
                    data-qty
                    value="{{ current_variant.quantity_rule.min | default: 1 }}"
                    min="{{ current_variant.quantity_rule.min | default: 1 }}"
                    {% if current_variant.quantity_rule.max %}max="{{ current_variant.quantity_rule.max }}"{% endif %}
                    step="{{ current_variant.quantity_rule.increment | default: 1 }}"
                  >
                  <button type="button" class="amoy-qty__btn" data-qty-step="1" aria-label="{{ 'accessibility.increase_quantity' | t }}">{% render 'icon', icon: 'plus', size: 16 %}</button>
                </div>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="amoy-pdp__buy" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="amoy-btn amoy-btn--primary amoy-btn--lg amoy-btn--full"
                  data-add-to-cart-submit
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  <span class="amoy-btn__label">{%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}</span>
                  <span class="amoy-btn__spinner" aria-hidden="true"></span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}

                <div class="amoy-pdp__form-error" data-form-error role="alert" hidden></div>
              </div>

            {%- when 'quote_link' -%}
              {%- assign quote_url = block.settings.link | default: '/pages/contact' -%}
              <a href="{{ quote_url }}" class="amoy-btn amoy-btn--secondary amoy-btn--full amoy-pdp__quote" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>

            {%- when 'volume_tiers' -%}
              {%- liquid
                assign tier_unit = current_variant.price | default: product.price
                assign keep = 100 | minus: block.settings.tier2_percent
                assign discounted = tier_unit | times: keep | divided_by: 100
                assign tier_quote_url = block.settings.quote_link | default: '/pages/contact'
              -%}
              <div class="amoy-tiers" {{ block.shopify_attributes }}>
                <div class="amoy-tiers__head">
                  <span>{{ 'tiers.quantity' | t }}</span>
                  <span>{{ 'tiers.price_per_unit' | t }}</span>
                </div>
                <div class="amoy-tiers__row">
                  <span>1&ndash;{{ block.settings.tier2_from | minus: 1 }}</span>
                  <span class="amoy-tiers__val">{{ tier_unit | money }}</span>
                </div>
                <div class="amoy-tiers__row">
                  <span>{{ block.settings.tier2_from }}&ndash;{{ block.settings.tier3_from | minus: 1 }} <span class="amoy-tiers__off">&minus;{{ block.settings.tier2_percent }}%</span></span>
                  <span class="amoy-tiers__val">{{ discounted | money }}</span>
                </div>
                <div class="amoy-tiers__row">
                  <span>{{ block.settings.tier3_from }}+</span>
                  <a href="{{ tier_quote_url }}" class="amoy-tiers__link">{{ 'tiers.request_quote' | t }}</a>
                </div>
              </div>

            {%- when 'specs' -%}
              <div class="amoy-pdp__specs" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="amoy-pdp__specs-title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if product.metafields.custom.specifications != blank -%}
                  <div class="rte">{{ product.metafields.custom.specifications | metafield_tag }}</div>
                {%- else -%}
                  {%- if product.vendor != blank -%}
                    <div class="amoy-spec-row"><span class="amoy-spec-row__key">{{ 'products.vendor' | t }}</span><span class="amoy-spec-row__val">{{ product.vendor }}</span></div>
                  {%- endif -%}
                  {%- if current_variant.sku != blank -%}
                    <div class="amoy-spec-row"><span class="amoy-spec-row__key">{{ 'products.sku' | t }}</span><span class="amoy-spec-row__val" data-variant-sku>{{ current_variant.sku }}</span></div>
                  {%- endif -%}
                  {%- assign spec_lines = block.settings.rows | newline_to_br | split: '<br />' -%}
                  {%- for line in spec_lines -%}
                    {%- assign parts = line | strip_newlines | split: '|' -%}
                    {%- if parts.size == 2 -%}
                      <div class="amoy-spec-row">
                        <span class="amoy-spec-row__key">{{ parts[0] | strip }}</span>
                        <span class="amoy-spec-row__val">{{ parts[1] | strip }}</span>
                      </div>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </div>

            {%- when 'trust' -%}
              <ul class="amoy-pdp__trust" {{ block.shopify_attributes }}>
                {%- if block.settings.item_1 != blank -%}
                  <li>{% render 'icon', icon: 'truck', size: 17 %}{{ block.settings.item_1 }}</li>
                {%- endif -%}
                {%- if block.settings.item_2 != blank -%}
                  <li>{% render 'icon', icon: 'shield', size: 17 %}{{ block.settings.item_2 }}</li>
                {%- endif -%}
              </ul>

            {%- when 'collapsible' -%}
              <details class="amoy-collapsible" {{ block.shopify_attributes }}>
                <summary class="amoy-collapsible__summary">
                  {{ block.settings.heading }}
                  {% render 'icon', icon: 'chevron-down', size: 18 %}
                </summary>
                <div class="amoy-collapsible__body rte">
                  {{ block.settings.content }}
                  {%- if block.settings.page != blank -%}{{ block.settings.page.content }}{%- endif -%}
                </div>
              </details>

            {%- when 'custom_liquid' -%}
              <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- when '@app' -%}
              <div class="amoy-pdp__app-block" {{ block.shopify_attributes }}>{% render block %}</div>

          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}
    </div>
  </div>
</div>

{%- unless is_quick -%}
  {%- if section.settings.show_recommendations -%}
    <div
      data-recommendations
      data-product-id="{{ product.id }}"
      data-limit="{{ section.settings.recommendations_count }}"
      data-intents="{% if section.settings.show_complementary %}complementary,{% endif %}related"
    ></div>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "header", "content": "Recommendations" },
    { "type": "checkbox", "id": "show_recommendations", "label": "Show product recommendations", "default": true, "info": "Complementary products are set up in the free Search & Discovery app. Related products work automatically." },
    { "type": "checkbox", "id": "show_complementary", "label": "Show complementary products row", "default": true },
    { "type": "range", "id": "recommendations_count", "min": 2, "max": 8, "step": 1, "label": "Products per row", "default": 4 }
  ],
  "blocks": [
    { "type": "type", "name": "Product type", "limit": 1 },
    { "type": "title", "name": "Title", "limit": 1 },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "price_note", "label": "Note under the price", "default": "per unit · volume discounts on 4+" },
        { "type": "checkbox", "id": "show_taxes_note", "label": "Show taxes and shipping note", "default": false }
      ]
    },
    {
      "type": "inventory",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "low_stock_threshold", "min": 1, "max": 20, "step": 1, "label": "Show low stock below", "default": 5 }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1 },
    { "type": "quantity", "name": "Quantity selector", "limit": 1 },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true, "info": "Shop Pay, Apple Pay and the other accelerated methods enabled in Settings → Payments." }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "quote_link",
      "name": "Bulk quote button",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Request a bulk quote instead" },
        { "type": "url", "id": "link", "label": "Link", "info": "Defaults to /pages/contact when empty." }
      ]
    },
    {
      "type": "volume_tiers",
      "name": "Volume pricing table",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Display only. Create the matching automatic discount under Discounts so it applies at checkout." },
        { "type": "range", "id": "tier2_from", "min": 2, "max": 20, "step": 1, "label": "Second tier starts at", "default": 4 },
        { "type": "range", "id": "tier2_percent", "min": 5, "max": 50, "step": 5, "unit": "%", "label": "Second tier discount", "default": 10 },
        { "type": "range", "id": "tier3_from", "min": 5, "max": 100, "step": 5, "label": "Quote tier starts at", "default": 10 },
        { "type": "url", "id": "quote_link", "label": "Quote link", "info": "Defaults to /pages/contact when empty." }
      ]
    },
    {
      "type": "specs",
      "name": "Specifications",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
        { "type": "paragraph", "content": "Vendor and SKU come from the product itself. Add fixed rows below as Label | Value, one per line. A product metafield custom.specifications overrides all of it." },
        { "type": "textarea", "id": "rows", "label": "Extra rows", "default": "Material | Fiberglass composite\nDefault finish | Semi-matte white\nBase | Tempered glass\nMade in | Saudi Arabia" }
      ]
    },
    {
      "type": "trust",
      "name": "Trust icons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "item_1", "label": "First item", "default": "Delivery across KSA" },
        { "type": "text", "id": "item_2", "label": "Second item", "default": "Custom finish available" }
      ]
    },
    {
      "type": "collapsible",
      "name": "Collapsible row",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content" },
        { "type": "page", "id": "page", "label": "Or pull content from a page" }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [{ "type": "liquid", "id": "custom_liquid", "label": "Custom Liquid" }]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Product information",
      "blocks": [
        { "type": "type" },
        { "type": "title" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "quantity" },
        { "type": "buy_buttons" },
        { "type": "quote_link" },
        { "type": "description" },
        { "type": "volume_tiers" },
        { "type": "specs" },
        { "type": "trust" }
      ]
    }
  ]
}
{% endschema %}
