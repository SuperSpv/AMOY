<section class="amoy-block" style="background:var(--navy-900)">
  <div class="amoy-container" style="max-width:760px;text-align:center">
    <div class="amoy-eyebrow amoy-eyebrow--brass" style="justify-content:center">Contact us</div>
    <h2 class="amoy-display amoy-display--lg" style="color:#fff;margin:18px 0 16px">{{ section.settings.heading }}</h2>
    <p style="font-size:17px;line-height:1.65;color:var(--navy-200);max-width:46ch;margin:0 auto 30px">{{ section.settings.subtext }}</p>
    <div class="amoy-cta__btns">
      <a href="{{ section.settings.whatsapp_url | default: 'https://wa.me/966547275228' }}" target="_blank" rel="noopener" class="amoy-btn amoy-btn--inverse amoy-btn--lg">{{ section.settings.quote_label }}</a>
      <a href="mailto:{{ section.settings.email | default: 'support@amoylimited.com' }}" class="amoy-btn amoy-btn--brass amoy-btn--lg">Email us</a>
    </div>
    <p style="font-size:13px;color:var(--navy-400);margin-top:26px">+966 54 727 5228 &middot; support@amoylimited.com &middot; Jeddah, Saudi Arabia</p>
  </div>
</section>
{% schema %}
{"name":"Kids · CTA","settings":[{"type":"text","id":"heading","label":"Heading","default":"Bring the Kids Collection to your store"},{"type":"textarea","id":"subtext","label":"Subtext","default":"Tell us about your children's boutique and we'll share finishes, sizes, lead times and pricing across Saudi Arabia."},{"type":"url","id":"whatsapp_url","label":"WhatsApp URL"},{"type":"text","id":"quote_label","label":"Button label","default":"Request quotation"},{"type":"text","id":"email","label":"Email","default":"support@amoylimited.com"}],"presets":[{"name":"Kids · CTA"}]}
{% endschema %}