<section class="amoy-block" style="background:var(--mist);border-top:1px solid var(--border-subtle);border-bottom:1px solid var(--border-subtle)">
  <div class="amoy-container">
    <div style="text-align:center;max-width:640px;margin:0 auto 56px">
      <div class="amoy-eyebrow" style="justify-content:center">{{ section.settings.eyebrow }}</div>
      <h2 class="amoy-display amoy-display--lg" style="margin:16px 0 0">{{ section.settings.heading }}</h2>
    </div>
    <div class="amoy-steps">
      {%- for block in section.blocks -%}
        <div class="amoy-step" {{ block.shopify_attributes }}>
          <div class="amoy-step__num">{{ block.settings.number }}</div>
          <h3 class="amoy-step__title">{{ block.settings.title }}</h3>
          <p class="amoy-step__body">{{ block.settings.body }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"How It Works","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"How it works"},{"type":"text","id":"heading","label":"Heading","default":"From brief to window in four steps."}],"blocks":[{"type":"step","name":"Step","settings":[{"type":"text","id":"number","label":"Number","default":"01"},{"type":"text","id":"title","label":"Title","default":"Consult"},{"type":"textarea","id":"body","label":"Body","default":"Share your store concept, collection mix and the look you're chasing."}]}],"max_blocks":4,"presets":[{"name":"How It Works","blocks":[{"type":"step","settings":{"number":"01","title":"Consult","body":"Share your store concept, collection mix and the look you're chasing."}},{"type":"step","settings":{"number":"02","title":"Customize","body":"We tailor form, pose, finish and base to your brand's exact specification."}},{"type":"step","settings":{"number":"03","title":"Craft","body":"Hand-built in our Jeddah workshop, then finished and quality-checked."}},{"type":"step","settings":{"number":"04","title":"Deliver","body":"Packed, certified and delivered to Riyadh, Jeddah, Dammam and beyond."}}]}]}
{% endschema %}