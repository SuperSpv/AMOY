 "gid://shopify/OnlineStoreThemeJsonTemplate/page.about?theme_id=159824969982": [
  {
   "locale": "ar",
   "key": "section.page.about.json.main.heading:1756smk0z2725",
   "value": "نصنع شخصيات، لا مجرّد أشكال.",
